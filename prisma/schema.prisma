generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- 認証 ---
// セッション管理はSupabase Auth側で行うため、Account/Session/VerificationTokenは持たない。
// SupabaseのユーザーID（auth.users.id）を外部キーとして紐付ける。

model User {
  id                 String  @id @default(cuid())
  supabaseUserId     String  @unique
  githubUserId       Int     @unique
  githubLogin        String  @unique
  name               String?
  email              String?
  image              String?
  githubAccessToken  String? @db.Text
  // 失効時に自動延長を試みるためのrefresh_token（githubAccessToken同様に暗号化して保存）。
  // Supabase Auth側の設定によっては払い出されず、その場合はnullのまま（現状どおり再ログイン導線にフォールバック）
  githubRefreshToken String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userInstallations    UserInstallation[]
  hiddenRepositories   HiddenRepository[]
  favoriteRepositories FavoriteRepository[]
  favoriteIssues       FavoriteIssue[]
  quickFilters         QuickFilter[]
  commentReads         IssueCommentRead[]
}

// --- GitHub App 連携 ---

enum AccountType {
  USER
  ORGANIZATION
}

enum RepositorySelection {
  ALL
  SELECTED
}

// GitHub App のインストール単位（個人アカウント or Organization ごとに1件）
model GithubInstallation {
  id                  String              @id @default(cuid())
  installationId      Int                 @unique
  accountId           Int
  accountLogin        String
  accountType         AccountType
  repositorySelection RepositorySelection
  suspendedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userInstallations UserInstallation[]
  repositories      Repository[]

  @@index([accountLogin])
}

// ログインユーザーとGitHub Appインストールの紐付け（同一インストールに複数ユーザーがアクセスできる場合を考慮）
model UserInstallation {
  id             String  @id @default(cuid())
  userId         String
  installationId String
  role           String?

  createdAt DateTime @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId])
}

model Repository {
  id                  String    @id @default(cuid())
  githubRepositoryId  Int       @unique
  installationId      String
  ownerLogin          String
  name                String
  fullName            String
  private             Boolean
  htmlUrl             String
  archived            Boolean   @default(false)
  defaultBranch       String
  // claude-issue-dispatch.ymlの存在有無による近似的な対応判定（#720）。DBに保存し、
  // リポジトリ同期のタイミング（GitHub Appインストール時・リポジトリ再同期時）で更新する。
  hasClaudeWorkflow   Boolean   @default(false)
  // ローカル起動プロトコルへの適合（#1073）。scripts/start-issue.sh 冒頭のマーカー行で判定する。
  // hasClaudeWorkflowとは軸が違う（あちらはActions側の対応）。導入順が「ワークフロー→ローカル」に
  // なるため、片方だけ対応済みという状態が普通に起きる。
  hasLocalStartScript Boolean   @default(false)
  lastSyncedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installation GithubInstallation   @relation(fields: [installationId], references: [id], onDelete: Cascade)
  issues       Issue[]
  hiddenBy     HiddenRepository[]
  favoritedBy  FavoriteRepository[]

  @@unique([installationId, fullName])
  @@index([installationId])
}

// ユーザーごとに左メニューで非表示にしたリポジトリ
model HiddenRepository {
  id           String @id @default(cuid())
  userId       String
  repositoryId String

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId])
}

// ユーザーごとにお気に入り登録したリポジトリ（ホーム画面に表示する）
model FavoriteRepository {
  id           String @id @default(cuid())
  userId       String
  repositoryId String

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId])
}

// --- Issueキャッシュ（M6: Webhookで差分反映） ---

enum IssueState {
  OPEN
  CLOSED
}

// GitHubのstate_reason（Issueがクローズ/オープンされた理由）
enum IssueStateReason {
  COMPLETED
  NOT_PLANNED
  REOPENED
}

model Issue {
  id              String            @id @default(cuid())
  githubIssueId   BigInt            @unique
  repositoryId    String
  number          Int
  title           String            @db.Text
  body            String?           @db.Text
  state           IssueState
  stateReason     IssueStateReason?
  htmlUrl         String
  authorLogin     String
  assigneeLogin   String?
  commentCount    Int               @default(0)
  milestoneTitle  String?
  milestoneOpen   Int?
  milestoneClosed Int?
  githubCreatedAt DateTime
  githubUpdatedAt DateTime
  githubClosedAt  DateTime?
  syncedAt        DateTime          @default(now())

  // 00.check-userラベルが最後に付与された日時（確認待ちフィルターを確認が古い順に
  // 並べるための基準）。ラベルが外れるとnullに戻す
  checkUserLabeledAt DateTime?

  // 「Claudeに質問する」ダイアログ経由の質問コメント（isAskClaudeQuestionComment）が
  // 投稿された日時。一覧画面はissueごとにコメント本文を取得しないため、Webhook
  // （issue_comment created）で質問コメントを検知した時点で記録し、対応する回答コメント
  // （isQaAnswerComment）が投稿されたらnullに戻す近似値として使う
  qaAnswerPendingAt DateTime?

  // 実際に最後にコメントが投稿された日時（issue_comment Webhookのaction=createdで記録）。
  // 確認待ちフィルターのソート基準はcheckUserLabeledAtよりこちらを優先する
  lastCommentAt DateTime?

  // GitHub Projects v2 の Status（例: "Implementation"）。projects_v2_item Webhookと
  // 再同期で反映する。Projectに未登録のIssueはnullで、そのときは従来どおり進捗ラベルから
  // 解決する（src/lib/issue-progress.ts の resolveProgressStatus）
  projectStatus String?

  // 対応する ProjectV2Item の node ID。Statusを更新する際の対象指定に使う
  projectItemId String?

  // AI要約（明示的なボタン操作で生成しDBにキャッシュする。自動生成はしない）
  aiSummary             String?   @db.Text
  aiSummaryCommentCount Int?
  aiSummaryGeneratedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository       Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  labels           IssueLabel[]
  favoritedBy      FavoriteIssue[]
  commentReadBy    IssueCommentRead[]
  commentSummaries IssueCommentSummary[]

  @@unique([repositoryId, number])
  @@index([repositoryId])
}

// コメント単位のAI要約（明示的なボタン操作で生成しDBにキャッシュする。コメント編集時にキャッシュ行を削除し、再生成を促す）
model IssueCommentSummary {
  id              String   @id @default(cuid())
  issueId         String
  githubCommentId BigInt
  summary         String   @db.Text
  generatedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, githubCommentId])
  @@index([issueId])
}

// ユーザーごとにお気に入り登録したIssue
model FavoriteIssue {
  id      String @id @default(cuid())
  userId  String
  issueId String

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([issueId])
}

// ユーザーごとに、Issueのコメントを何件まで読んだか（未読コメント判定用）
model IssueCommentRead {
  id               String @id @default(cuid())
  userId           String
  issueId          String
  readCommentCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([issueId])
}

// ユーザーごとに保存したよく使うフィルター（PC左メニュー・スマホホーム画面に表示）
model QuickFilter {
  id       String  @id @default(cuid())
  userId   String
  name     String
  view     String  @default("all")
  q        String  @default("")
  repo     String?
  state    String  @default("open")
  labels   String  @default("")
  assignee String?
  sort     String  @default("created")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// GitHub API消費の内訳計測（src/lib/github/api-usage.ts）を、プロセス再起動をまたいで
// 保持するための永続化先。5分バケット単位でupsertし、直近24時間より古い行は随時削除する
model GithubApiUsageBucket {
  id        String   @id @default(cuid())
  startedAt DateTime
  feature   String
  endpoint  String
  count     Int

  @@unique([startedAt, feature, endpoint])
  @@index([startedAt])
}

// アプリ全体で共通の設定値を保持するシングルトンテーブル（id=1固定の1行のみ）。
// autoRetryLimit: claude-issue-dispatch.ymlのフォールバック時に自動リトライする回数の上限
// （0は自動リトライ無効）。リポジトリ間で個別設定にする必要が無いため全リポジトリ共通の値とする（#497）。
// claudeModel: claude-issue-dispatch.ymlがclaude-code-action起動時に付与する--modelの値。
// "auto"の場合は--modelを付与せずclaude-code-action側のデフォルトモデルに委ねる（#622）。
model AppSetting {
  id                  Int      @id @default(1)
  autoRetryLimit      Int      @default(0)
  claudeModel         String   @default("auto")
  // 質問応答・サブIssue分割のような補助的な処理に使うモデル(#905)。実装・計画とは品質要求が
  // 異なり、同じモデルで動かすとコストに見合わないため分けている。
  claudeModelAssist   String   @default("auto")
  // サブPCへディスパッチしたジョブを同時に何本まで走らせるか（#1179）。**定数で埋め込まない。**
  // CPUの載せ替えで変わる値で、埋め込むと作り直しになる（#1176）。既定の2は#1177の実測
  // （Athlon 200GE 2C/4Tで並行3本が上限、実運用の快適さでは2本）にもとづく。
  dispatchConcurrency Int      @default(2)
  updatedAt           DateTime @updatedAt
}

// Fine-grained PAT（例: secrets.WORKFLOW_PAT）等、有効期限を追跡したいトークンの管理台帳。
// GitHub側は発行済みトークンの実際の有効期限をAPIで取得できないため、GitHubのPAT設定画面で
// 確認した有効期限をユーザーが手入力で登録する運用とする（#759）。全リポジトリ共通の設定。
model FineGrainedToken {
  id        String   @id @default(cuid())
  name      String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- サブPCへのディスパッチ（#1179） ---

// ジョブの状態。queued → claimed → running → succeeded/failed が正常系で、
// claim後に進まない・heartbeatが途絶えたものはTIMEOUTへ落とす（src/lib/dispatch/jobs.ts）。
//
// **SUCCEEDEDは「tmuxセッションが立ち上がった」までを意味し、実装の完了ではない。**
// 以降の進捗はProject Status（POST /api/progress）が持つ唯一の正で、ここでは追わない。
// SKIPPEDは「起動する必要が無かった」（#1229）。既にそのIssueのtmuxセッションが動いていた
// ためpollerが起動を見送った場合で、**失敗でも成功でもない第3の結果**。FAILEDへ寄せると
// 正常に働いた安全機構が画面上は赤い「失敗」に見え、SUCCEEDEDへ寄せると「起動した」と
// 「既に動いていた」が後からログで区別できなくなる。
enum DispatchJobStatus {
  QUEUED
  CLAIMED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  TIMEOUT
  CANCELED
}

// ジョブの種別（#1332）。**LAUNCHだけが「セッションを立てる」ジョブ**で、残りは既に立っている
// セッションを操作する制御ジョブ。
//
// **別モデルにせず同じテーブルへ載せているのは、claim・報告・タイムアウト・画面表示の一式が
// そのまま使えるため**（受信経路も認証も同じで、寿命だけが短い）。分けると同じ仕組みを
// もう1セット持つことになる。
//
// INTERRUPT=`tmux send-keys -t <セッション名> C-c`（走っている処理を中断する。セッションは残る）/
// KILL=`tmux kill-session -t <セッション名>`（セッションごと畳む）。
// **poller側はセッション名をジョブのrepositoryFullName/issueNumberから組み立て直し、
// 受け取った名前と一致しなければ実行しない**（任意コマンド実行の経路にしないため）。
enum DispatchJobKind {
  LAUNCH
  INTERRUPT
  KILL
}

// issue-deckの画面から積み、サブPCのpollerがポーリングで取りに来るジョブ（#1179）。
//
// 方式がpull型なのは、VPSがtailnetに参加しておらず、Tailscale SSHにforced commandが
// 無いため（#1176）。issue-deckはジョブを置くだけで、SSH等でサブPCへ届けには行かない。
//
// **RepositoryやIssueへの外部キーは張らない。** リポジトリ同期が済んでいないIssueでも
// 積めるようにするためで、リポジトリはowner/nameの文字列で持つ（/api/progressと同じ形）。
model DispatchJob {
  id                 String            @id @default(cuid())
  repositoryFullName String
  issueNumber        Int
  // 起動先として指定されたホスト名（DispatchHost.nameと対応）
  targetHost         String
  // 何をするジョブか（#1332）。既存行はすべて起動ジョブなのでLAUNCHが既定
  kind               DispatchJobKind   @default(LAUNCH)
  status             DispatchJobStatus @default(QUEUED)
  // 「同じIssueに対する未完了ジョブは1件まで」をDBに保証させるための列（#1179）。
  // 未完了の間だけ `owner/repo#番号` が入り、終了時にnullへ戻す。MySQLのunique indexは
  // 複数のNULLを許すため、終了したジョブは同じIssueで何件でも並べられる。
  // アプリ側の存在チェックだけに頼ると、二重クリックの競合で二重起動が通る。
  //
  // **種別ごとに名前空間を分ける**（#1332。制御ジョブは `interrupt:owner/repo#番号`）。
  // 制御ジョブでnullにすると起動ジョブとは衝突しない代わりに、スマホでの連打ぶんだけ
  // `C-c`が積まれる。前置きを付ければ衝突せず、「未処理の停止は1件まで」も同時に守れる。
  activeKey          String?           @unique
  // 画面から積んだユーザー（User.id）。Userを消してもジョブの履歴は残すためFKは張らない
  requestedByUserId  String?
  claimedByHost      String?
  claimedAt          DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  // RUNNING中の生存報告。途絶えたらTIMEOUTへ落とす
  heartbeatAt        DateTime?
  // 起動したtmuxセッション名。実行ログを見る唯一の手掛かり（`tmux attach -t <名前>`）で、
  // Actions UIに相当するものが無いローカル実行ではこれがログの在り処になる
  tmuxSessionName    String?
  // 失敗理由・結果の要約。**画面にそのまま出す前提**。「投げたのに何も起きない」を避けるため、
  // clone未登録・版数不一致・tmux起動失敗といった理由をここへ入れて返す
  message            String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([targetHost, status])
  @@index([targetHost, status, kind])
  @@index([repositoryFullName, issueNumber])
}

// ジョブを実行できるホストの申告（#1179）。サブPCが定期的にpushする。
//
// **「実行できるリポジトリの一覧」をここに持つのは、ジョブの割り当て可否を決める情報だから**
// （#1176のコメント）。ホストの死活・CPU・メモリ・tmuxセッション一覧はops-dashboard#34側の
// 担当で、issue-deckには持ち込まない。
//
// 申告は`scripts/subpc-dispatch-poller.sh`が`~/.config/issue-deck/local-repos.conf`を走査し、
// `scripts/start-local-session.sh`と同じ4つの検証を通ったものだけを載せる。判定を二重に
// 持たないよう、検証ロジックは`scripts/lib/local-repo-resolve.sh`で共有している。
model DispatchHost {
  id                String   @id @default(cuid())
  name              String   @unique
  // 実行可能と申告されたリポジトリのJSON配列（例: `["guchi-apps/issue-deck"]`）。
  // 数件しか無く、別テーブルにしてまで検索する必要が無いためテキストで持つ
  repositories      String   @db.Text
  // ホストの受け口が扱えるローカル起動プロトコルの上限版数
  // （src/lib/local-session.ts の LOCAL_SESSION_CONTRACT_VERSION と対応）
  contractVersion   Int?
  // ホスト側が申告する同時実行数の上限。AppSetting.dispatchConcurrencyとminを取る
  maxConcurrency    Int?
  // pollerのバージョン。受け口が古いまま動いているかの手掛かり
  agentVersion      String?
  // スクリーンショットを撮れるか（#1268）。Playwrightのブラウザ本体が入っているかで判定する。
  // **`null`は「申告していない」**（古いpoller）で、`false`（撮れない）とは区別する。
  // 無人実行では依存の追加をその場で確認する相手がいないため、撮れないホストで
  // `24.screenshot-required`を選ばせると必ず詰まる
  screenshotCapable Boolean?
  // 走っているセッションを画面から操作できるか（#1332）。pollerが対応版で申告する。
  // **`null`（未申告＝古いpoller）は「できない」として扱う**。`screenshotCapable`とは逆で、
  // 判定材料が無いまま制御ジョブを配ると、古いpollerは`kind`を読まないため
  // **起動ジョブとして解釈してセッションを立てる**（「閉じる」を押して起動する）
  sessionControlCapable Boolean?
  // 最後に申告が届いた時刻。一定時間途絶えたホストはoffline扱いでenqueueを拒否する
  lastSeenAt        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 起動後のtmuxセッションの状態（#1217）。サブPCのpollerが1巡ごとに報告する。
//
// **DispatchJobを伸ばさず別のモデルにしているのは、寿命が違うため。** ジョブは「起動の記録」で
// tmuxセッションが立った時点でSUCCEEDEDになり終わる（`run_job()`がそう報告する）。そこへ
// セッションの生存を混ぜると、未完了ジョブを1件に制限しているactiveKeyの意味が壊れる。
//
// **画面（capture-pane）の内容は持たない。** 実装中のコード・環境変数が映りうるうえ、画面の
// 文字列から状態を推定する方式は既に実地で誤判定している（#1219・#1223）。入力待ち・完了・停滞は
// Claude Codeのフックが担当し（#1219）、こちらはフックが飛ばない「プロセスの死・消失」だけを見る。
model DispatchSession {
  id                 String                @id @default(cuid())
  // 報告してきたホスト名（DispatchHost.nameと対応）
  host               String
  tmuxSessionName    String
  repositoryFullName String
  issueNumber        Int
  state              DispatchSessionState
  // 異常終了したときの終了コード（tmuxの`#{pane_dead_status}`）。原因の手掛かりとして残す
  exitStatus         Int?
  firstSeenAt        DateTime
  lastReportedAt     DateTime
  // どの状態で引き上げ済みか。pollerは60秒ごとに同じ報告を送るため、これが無いと毎分コメントが増える。
  // FAILED以外へ移ったらnullへ戻し、復帰後に再び落ちた場合の2回目を拾えるようにする
  escalatedState     DispatchSessionState?
  escalatedAt        DateTime?

  // セッション自身がフック（#1219）から報告してくる直近の様子（#1264）。pollerが見ている
  // tmuxのメタデータでは分からない「人の入力を待っているか」を、画面へ出すために持つ。
  //
  // **古い値が残り続けないことが前提。** WAITING_INPUTはStopフック（RESPONDEDへ遷移）か、
  // セッションの消滅（pollerの報告でEXITED/FAILED/GONEになる）のどちらかで必ず解ける。
  activity         DispatchSessionActivity?
  activityAt       DateTime?
  // claude --remote-control が表示するURL。スマホから答えるための唯一の出口なので、
  // 通知（Signaly）だけでなく画面にも出す。取れないこともある（Claude Codeの内部ファイル依存）
  remoteControlUrl String?                  @db.Text
  // tailscale serveでtailnetへ出した開発サーバーのURL（#1265）。スマホから画面を見る唯一の
  // 出口なので画面へ出す。`23.preview-required`が付いたセッションでだけ埋まる
  previewUrl       String?                  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([host, tmuxSessionName])
  @@index([state])
}

// ALIVE=ペインが生きている / EXITED=正常終了して残っている / FAILED=異常終了して残っている /
// GONE=報告に含まれなくなった（セッションが消えた）。
//
// **引き上げるのはFAILEDだけ。** GONEは人が作業を終えて畳んだ場合と区別が付かず、むしろ
// そちらの方が多いため、鳴らすとノイズになって本当の異常終了が埋もれる。
// セッション自身がフックから報告してくる様子（#1264）。
//
// WAITING_INPUT=承認プロンプト・AskUserQuestionで人の入力を待っている /
// RESPONDED=応答が終わった（無人で回すセッションでは実質「作業完了」）。
//
// **停滞・完了の判定には使わない。** これは「今この瞬間セッションが何をしているか」で、
// 実装の進捗はProject Statusが唯一の正（docs/progress-status-architecture.md）。
enum DispatchSessionActivity {
  WAITING_INPUT
  RESPONDED
}

enum DispatchSessionState {
  ALIVE
  EXITED
  FAILED
  GONE
}

model IssueLabel {
  id            String  @id @default(cuid())
  issueId       String
  githubLabelId BigInt?
  name          String
  color         String
  description   String?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, name])
  @@index([githubLabelId])
}
