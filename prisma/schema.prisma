generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- 認証 ---
// セッション管理はSupabase Auth側で行うため、Account/Session/VerificationTokenは持たない。
// SupabaseのユーザーID（auth.users.id）を外部キーとして紐付ける。

model User {
  id                 String  @id @default(cuid())
  supabaseUserId     String  @unique
  githubUserId       Int     @unique
  githubLogin        String  @unique
  name               String?
  email              String?
  image              String?
  githubAccessToken  String? @db.Text
  // 失効時に自動延長を試みるためのrefresh_token（githubAccessToken同様に暗号化して保存）。
  // Supabase Auth側の設定によっては払い出されず、その場合はnullのまま（現状どおり再ログイン導線にフォールバック）
  githubRefreshToken String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userInstallations    UserInstallation[]
  hiddenRepositories   HiddenRepository[]
  favoriteRepositories FavoriteRepository[]
  favoriteIssues       FavoriteIssue[]
  commentReads         IssueCommentRead[]
  pushSubscriptions    PushSubscription[]
  snoozedItems         SnoozedItem[]
}

// --- GitHub App 連携 ---

enum AccountType {
  USER
  ORGANIZATION
}

enum RepositorySelection {
  ALL
  SELECTED
}

// GitHub App のインストール単位（個人アカウント or Organization ごとに1件）
model GithubInstallation {
  id                  String              @id @default(cuid())
  installationId      Int                 @unique
  accountId           Int
  accountLogin        String
  accountType         AccountType
  repositorySelection RepositorySelection
  suspendedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userInstallations UserInstallation[]
  repositories      Repository[]

  @@index([accountLogin])
}

// ログインユーザーとGitHub Appインストールの紐付け（同一インストールに複数ユーザーがアクセスできる場合を考慮）
model UserInstallation {
  id             String  @id @default(cuid())
  userId         String
  installationId String
  role           String?

  createdAt DateTime @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId])
}

model Repository {
  id                  String    @id @default(cuid())
  githubRepositoryId  Int       @unique
  installationId      String
  ownerLogin          String
  name                String
  fullName            String
  private             Boolean
  htmlUrl             String
  archived            Boolean   @default(false)
  defaultBranch       String
  // claude-issue-dispatch.ymlの存在有無による近似的な対応判定（#720）。DBに保存し、
  // リポジトリ同期のタイミング（GitHub Appインストール時・リポジトリ再同期時）で更新する。
  hasClaudeWorkflow   Boolean   @default(false)
  // ローカル起動プロトコルへの適合（#1073）。scripts/start-issue.sh 冒頭のマーカー行で判定する。
  // hasClaudeWorkflowとは軸が違う（あちらはActions側の対応）。導入順が「ワークフロー→ローカル」に
  // なるため、片方だけ対応済みという状態が普通に起きる。
  hasLocalStartScript Boolean   @default(false)
  lastSyncedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installation GithubInstallation   @relation(fields: [installationId], references: [id], onDelete: Cascade)
  issues       Issue[]
  hiddenBy     HiddenRepository[]
  favoritedBy  FavoriteRepository[]
  snoozedItems SnoozedItem[]

  @@unique([installationId, fullName])
  @@index([installationId])
}

// ユーザーごとに左メニューで非表示にしたリポジトリ
model HiddenRepository {
  id           String @id @default(cuid())
  userId       String
  repositoryId String

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId])
}

// ユーザーごとにお気に入り登録したリポジトリ（ホーム画面に表示する）
model FavoriteRepository {
  id           String @id @default(cuid())
  userId       String
  repositoryId String

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId])
}

// --- Issueキャッシュ（M6: Webhookで差分反映） ---

enum IssueState {
  OPEN
  CLOSED
}

// GitHubのstate_reason（Issueがクローズ/オープンされた理由）
enum IssueStateReason {
  COMPLETED
  NOT_PLANNED
  REOPENED
}

model Issue {
  id              String            @id @default(cuid())
  githubIssueId   BigInt            @unique
  repositoryId    String
  number          Int
  title           String            @db.Text
  body            String?           @db.Text
  state           IssueState
  stateReason     IssueStateReason?
  htmlUrl         String
  authorLogin     String
  assigneeLogin   String?
  commentCount    Int               @default(0)
  milestoneTitle  String?
  milestoneOpen   Int?
  milestoneClosed Int?
  githubCreatedAt DateTime
  githubUpdatedAt DateTime
  githubClosedAt  DateTime?
  syncedAt        DateTime          @default(now())

  // 00.check-userラベルが最後に付与された日時（確認待ちフィルターを確認が古い順に
  // 並べるための基準）。ラベルが外れるとnullに戻す
  checkUserLabeledAt DateTime?

  // 上の確認待ちについてPush通知（#838）を送った日時。**送信済みの目印にしか使わない**。
  // checkUserLabeledAtが新しく立つたび（＝ラベルが付き直すたび）にnullへ戻すので、
  // 「checkUserPushSentAtがnullで、付与から一定時間が経っているもの」が未送信の集合になる
  checkUserPushSentAt DateTime?

  // 「質問する」ボタン経由の質問コメント（isAskClaudeQuestionComment）が
  // 投稿された日時。一覧画面はissueごとにコメント本文を取得しないため、Webhook
  // （issue_comment created）で質問コメントを検知した時点で記録し、対応する回答コメント
  // （isQaAnswerComment）が投稿されたらnullに戻す近似値として使う
  qaAnswerPendingAt DateTime?

  // 実際に最後にコメントが投稿された日時（issue_comment Webhookのaction=createdで記録）。
  // 確認待ちフィルターのソート基準はcheckUserLabeledAtよりこちらを優先する
  lastCommentAt DateTime?

  // GitHub Projects v2 の Status（例: "Implementation"）。projects_v2_item Webhookと
  // 再同期で反映する。Projectに未登録のIssueはnullで、そのときは従来どおり進捗ラベルから
  // 解決する（src/lib/issue-progress.ts の resolveProgressStatus）
  projectStatus String?

  // 対応する ProjectV2Item の node ID。Statusを更新する際の対象指定に使う
  projectItemId String?

  // AI要約（明示的なボタン操作で生成しDBにキャッシュする。自動生成はしない）
  aiSummary             String?   @db.Text
  aiSummaryCommentCount Int?
  aiSummaryGeneratedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository       Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  labels           IssueLabel[]
  favoritedBy      FavoriteIssue[]
  commentReadBy    IssueCommentRead[]
  commentSummaries IssueCommentSummary[]

  @@unique([repositoryId, number])
  @@index([repositoryId])
}

// コメント単位のAI要約（明示的なボタン操作で生成しDBにキャッシュする。コメント編集時にキャッシュ行を削除し、再生成を促す）
model IssueCommentSummary {
  id              String   @id @default(cuid())
  issueId         String
  githubCommentId BigInt
  summary         String   @db.Text
  generatedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, githubCommentId])
  @@index([issueId])
}

// ユーザーごとにお気に入り登録したIssue
model FavoriteIssue {
  id      String @id @default(cuid())
  userId  String
  issueId String

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([issueId])
}

// 保留の対象（#2398）。IssueとPull Requestは同じリポジトリの番号空間なので、
// 種別と番号の組で1つのテーブルに載せる。
enum SnoozeTargetKind {
  ISSUE
  PULL_REQUEST
}

// ユーザーごとに「いまは実施しない」として伏せた要対応の項目（#2398）。
//
// **Issueへの外部キーは張らない。** 対象にはマージ待ちのPull Requestも含まれ、そちらは
// DBに行を持たない（GitHubから都度取得する）。IssueだけFKにすると同じ機能が2つの
// テーブルに割れるため、`repositoryId` + `kind` + `number`で両方を指す。
//
// `until`がnullなら「手動で解除するまで」。過ぎた行は消さずに残し、
// 有効かどうかの判定は`src/lib/snooze.ts`の純粋関数が現在時刻を見て行う
// （件数・一覧・通知が同じ関数を通る）。
model SnoozedItem {
  id           String           @id @default(cuid())
  userId       String
  repositoryId String
  kind         SnoozeTargetKind
  number       Int
  // 保留が解けて件数・通知へ戻る時刻。nullは「手動で解除するまで」
  until        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId, kind, number])
  @@index([repositoryId])
}

// ユーザーごとに、Issueのコメントを何件まで読んだか（未読コメント判定用）
model IssueCommentRead {
  id               String @id @default(cuid())
  userId           String
  issueId          String
  readCommentCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([issueId])
}

// GitHub API消費の内訳計測（src/lib/github/api-usage.ts）を、プロセス再起動をまたいで
// 保持するための永続化先。5分バケット単位でupsertし、直近24時間より古い行は随時削除する
model GithubApiUsageBucket {
  id        String   @id @default(cuid())
  startedAt DateTime
  feature   String
  endpoint  String
  count     Int

  @@unique([startedAt, feature, endpoint])
  @@index([startedAt])
}

// issue-deck自身が投げたAnthropic API（/v1/messages）の消費を、機能別・モデル別に5分バケットで
// 保持する（#2347）。GithubApiUsageBucketと同じで、正はプロセス内メモリ（src/lib/claude/api-usage.ts）で
// あり、この表は再起動をまたいで直近7日ぶんを引き継ぐためだけに使う。7日より古い行は
// 書き出しのたびに削除する。
//
// **書き出しはバケットの繰り上がり時ではなく呼び出しのたび。** AIの呼び出しはボタン起点で
// 次まで数時間空くことがあり、繰り上がりを待つと直近の消費が保存されないまま消える。
//
// トークン数は推計ではなく、応答のusageが返す実測値。GitHub Actionsの無人実行や
// ローカルセッション（Claude Code本体）の消費はここに入らない。
model ClaudeApiUsageBucket {
  id                  String   @id @default(cuid())
  startedAt           DateTime
  feature             String
  model               String
  calls               Int
  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int
  cacheCreationTokens Int

  @@unique([startedAt, feature, model])
  @@index([startedAt])
}

// アプリ全体で共通の設定値を保持するシングルトンテーブル（id=1固定の1行のみ）。
// autoRetryLimit: claude-issue-dispatch.ymlのフォールバック時に自動リトライする回数の上限
// （0は自動リトライ無効）。リポジトリ間で個別設定にする必要が無いため全リポジトリ共通の値とする（#497）。
// claudeModel: claude-issue-dispatch.ymlがclaude-code-action起動時に付与する--modelの値。
// "auto"の場合は--modelを付与せずclaude-code-action側のデフォルトモデルに委ねる（#622）。
model AppSetting {
  id                  Int      @id @default(1)
  autoRetryLimit      Int      @default(0)
  claudeModel         String   @default("auto")
  // 質問応答・サブIssue分割のような補助的な処理に使うモデル(#905)。実装・計画とは品質要求が
  // 異なり、同じモデルで動かすとコストに見合わないため分けている。
  claudeModelAssist   String   @default("auto")
  // サブPCへディスパッチしたジョブを同時に何本まで走らせるか（#1179）。**定数で埋め込まない。**
  // CPUの載せ替えで変わる値で、埋め込むと作り直しになる（#1176）。既定の3はRyzen 5 PRO 4650G
  // （6C/12T）での実測（guchi-apps/subpc#19・#1812）にもとづく。根拠はsrc/lib/app-settings.ts。
  dispatchConcurrency Int      @default(3)
  updatedAt           DateTime @updatedAt
}

// Fine-grained PAT（例: secrets.WORKFLOW_PAT）等、有効期限を追跡したいトークンの管理台帳。
// GitHub側は発行済みトークンの実際の有効期限をAPIで取得できないため、GitHubのPAT設定画面で
// 確認した有効期限をユーザーが手入力で登録する運用とする（#759）。全リポジトリ共通の設定。
model FineGrainedToken {
  id        String   @id @default(cuid())
  name      String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- サブPCへのディスパッチ（#1179） ---

// ジョブの状態。queued → claimed → running → succeeded/failed が正常系で、
// claim後に進まない・heartbeatが途絶えたものはTIMEOUTへ落とす（src/lib/dispatch/jobs.ts）。
//
// **SUCCEEDEDは「tmuxセッションが立ち上がった」までを意味し、実装の完了ではない。**
// 以降の進捗はProject Status（POST /api/progress）が持つ唯一の正で、ここでは追わない。
// SKIPPEDは「起動する必要が無かった」（#1229）。既にそのIssueのtmuxセッションが動いていた
// ためpollerが起動を見送った場合で、**失敗でも成功でもない第3の結果**。FAILEDへ寄せると
// 正常に働いた安全機構が画面上は赤い「失敗」に見え、SUCCEEDEDへ寄せると「起動した」と
// 「既に動いていた」が後からログで区別できなくなる。
enum DispatchJobStatus {
  QUEUED
  CLAIMED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  TIMEOUT
  CANCELED
}

// ジョブの種別（#1332）。**LAUNCHだけが「セッションを立てる」ジョブ**で、残りは既に立っている
// セッションを操作する制御ジョブ。
//
// **別モデルにせず同じテーブルへ載せているのは、claim・報告・タイムアウト・画面表示の一式が
// そのまま使えるため**（受信経路も認証も同じで、寿命だけが短い）。分けると同じ仕組みを
// もう1セット持つことになる。
//
// INTERRUPT=`tmux send-keys -t <セッション名> C-c`（走っている処理を中断する。セッションは残る）/
// KILL=`tmux kill-session -t <セッション名>`（セッションごと畳む）。
// **poller側はセッション名をジョブのrepositoryFullName/issueNumberから組み立て直し、
// 受け取った名前と一致しなければ実行しない**（任意コマンド実行の経路にしないため）。
//
// QUESTION（#1294）はセッションを立てず、読み取り専用の質問応答を1回走らせて回答コメントを
// 投稿するジョブ。**activeKeyを取らない**（下記`activeKey`のコメント参照）。
// **まだ積む経路も払い出し口も無い**（器だけを先に入れている）。実行はStep 3（別Issue）で、
// poller側の対応申告とセットで開ける。
// MANUAL_STEP_ABORT（#1882）は走っている代行実行（MANUAL_STEP）を止めるジョブ。
// pollerが`systemctl --user stop issue-deck-manual-step-<対象ジョブID>`を実行する。
// **セッションを操作するジョブではない**（相手はtmuxではなくtransient unit）ため、
// `SESSION_CONTROL_JOB_KINDS`ではなく`OUT_OF_BAND_JOB_KINDS`に入れて枠外で先に配る。
// 止める対象は`targetJobId`で指す（pollerはユニット名を組み立て直す。任意の
// `systemctl stop`を流す経路にしない）。
// PLAN_REVIEW（#1855）は計画の関門（G1・#1218）のセッションを立てるジョブ。CROSS_REPO_QUESTIONと
// 同じく「セッションを立てる」側で、worktreeは作らず対象リポジトリの`origin/develop`の
// スナップショットを読むだけ。**実装セッションが承認待ちで生きている最中に走るのが常態**なので、
// 起動ジョブと違って「そのIssueのセッションが動いている」ことを理由に弾かない。
// CODE_REVIEW（#698）はリポジトリ全体のコードレビューのセッションを立てるジョブ。PLAN_REVIEWと
// 同じく`origin/develop`のスナップショットを読むだけで、指摘は**レビュー用に1件作ったIssueへの
// コメント**として返す。対象リポジトリのcloneが要る点もPLAN_REVIEWと同じ。
enum DispatchJobKind {
  LAUNCH
  INTERRUPT
  KILL
  QUESTION
  INSTRUCTION
  CROSS_REPO_QUESTION
  MANUAL_STEP
  MANUAL_STEP_ABORT
  PLAN_REVIEW
  SELF_UPDATE
  CODE_REVIEW
  PREVIEW
}

// issue-deckの画面から積み、サブPCのpollerがポーリングで取りに来るジョブ（#1179）。
//
// 方式がpull型なのは、VPSがtailnetに参加しておらず、Tailscale SSHにforced commandが
// 無いため（#1176）。issue-deckはジョブを置くだけで、SSH等でサブPCへ届けには行かない。
//
// **RepositoryやIssueへの外部キーは張らない。** リポジトリ同期が済んでいないIssueでも
// 積めるようにするためで、リポジトリはowner/nameの文字列で持つ（/api/progressと同じ形）。
model DispatchJob {
  id                 String            @id @default(cuid())
  repositoryFullName String
  issueNumber        Int
  // 起動先として指定されたホスト名（DispatchHost.nameと対応）
  targetHost         String
  // 何をするジョブか（#1332）。既存行はすべて起動ジョブなのでLAUNCHが既定
  kind               DispatchJobKind   @default(LAUNCH)
  status             DispatchJobStatus @default(QUEUED)
  // 「同じIssueに対する未完了ジョブは1件まで」をDBに保証させるための列（#1179）。
  // 未完了の間だけ `owner/repo#番号` が入り、終了時にnullへ戻す。MySQLのunique indexは
  // 複数のNULLを許すため、終了したジョブは同じIssueで何件でも並べられる。
  // アプリ側の存在チェックだけに頼ると、二重クリックの競合で二重起動が通る。
  //
  // **種別ごとに名前空間を分ける**（#1332。制御ジョブは `interrupt:owner/repo#番号`）。
  // 制御ジョブでnullにすると起動ジョブとは衝突しない代わりに、スマホでの連打ぶんだけ
  // `C-c`が積まれる。前置きを付ければ衝突せず、「未処理の停止は1件まで」も同時に守れる。
  //
  // **質問ジョブ（QUESTION）だけはnullのままにする**（#1294）。「未完了は1件まで」は実装ジョブの
  // 二重起動を防ぐための制約で、質問には当てはまらない。ここで枠を取ると、
  // **実装ジョブが走っているIssueに質問を積めなくなる**（質問はまさに実装中に割り込んで
  // 聞くための機能なので、それでは意味が無い）。
  activeKey          String?           @unique
  // 画面から積んだユーザー（User.id）。Userを消してもジョブの履歴は残すためFKは張らない
  requestedByUserId  String?
  claimedByHost      String?
  claimedAt          DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  // RUNNING中の生存報告。途絶えたらTIMEOUTへ落とす
  heartbeatAt        DateTime?
  // 起動したtmuxセッション名。実行ログを見る唯一の手掛かり（`tmux attach -t <名前>`）で、
  // Actions UIに相当するものが無いローカル実行ではこれがログの在り処になる
  tmuxSessionName    String?
  // 失敗理由・結果の要約。**画面にそのまま出す前提**。「投げたのに何も起きない」を避けるため、
  // clone未登録・版数不一致・tmux起動失敗といった理由をここへ入れて返す
  message            String?           @db.Text
  // 走っているセッションへ流す追加指示の本文（#1012。`kind`が`INSTRUCTION`のときだけ入る）。
  //
  // **改行を含まない1行だけを受ける。** 複数行は確定キーの解釈が画面の実装に依存する。
  // 長い指示はIssueコメントに書き、ここへは「コメントを読んでから続けて」の1行を流す。
  //
  // **組み立てるのは人だけで、実行体が状況から本文を決めて自動送信する経路は作らない**
  // （docs/multi-agent/gates.md）。画面のプリセットも、押すのは人という点は変わらない。
  instruction        String?           @db.Text
  // 手作業アシスタントから代行実行するコマンド（#1828。`kind`が`MANUAL_STEP`のときだけ入る）。
  //
  // **入るのはサーバーが手作業Issueの本文から抽出し直したものだけ。** 画面から届いた文字列は
  // 「人が承認したのはこれか」の照合にしか使わず、そのまま保存も実行もしない。これがこの経路を
  // 「画面から任意のコマンドを流せる口」にしないための一次の歯止めになっている
  // （二次の歯止めはサブPC側で、pollerがGitHubの本文を読み直して同じ照合をもう一度行う）。
  command            String?           @db.Text
  // 人が埋めたプレースホルダの値（#2403。`<控えたkey>`の表記 → 値のマップ）。
  //
  // **`command`は`<…>`が入ったままのテンプレートで保存する。** 本文との照合（サーバーとpollerが
  // 独立に2回行う）が見るのはそちらで、値はpollerが照合を通したあとに`'…'`で包んで穴へ差し込む。
  // したがって画面から届いた値は**リテラルの1語**にしかならず、コマンドの構造を変えられない。
  //
  // **シークレット（トークン・キー）が入りうる。** 出力（`commandOutput`）と同じ扱いで、
  // GitHubのIssueにも通知にもpollerのログにも出さない。さらに**ジョブが終わった時点で空にする**
  // ——出力と違い、後から確かめるための手掛かりとしての価値が無いため残す理由が無い。
  placeholderValues  Json?
  // 代行実行した手順の、本文中の行番号（#1828。`- [ ]`の行）。画面がジョブと手順を対応付ける。
  //
  // **チェックを付けるのはこの行ではなく画面側**（`hooks/use-issue-task-list.ts`）。ここに持つのは
  // 「どの手順を実行したのか」を後から辿るためで、行が持つ意味はあくまで記録。
  manualStepLine     Int?
  // 止める対象のジョブid（#1882。`kind`が`MANUAL_STEP_ABORT`のときだけ入る）。
  //
  // **pollerへ渡すのはこのidだけで、実行するコマンドは渡さない。** pollerが
  // `issue-deck-manual-step-<id>`というユニット名を組み立て直して止めるので、
  // この経路が任意の`systemctl stop`を流す口にはならない（`INTERRUPT`・`KILL`が
  // セッション名を組み立て直すのと同じ作法）。
  targetJobId        String?
  // 確認環境（#2444）に対する操作。`kind`が`PREVIEW`のときだけ入る。
  //
  //   start    そのリポジトリのdevelopで起こす（他のリポジトリが動いていれば止めてから）
  //   refresh  動いているものを最新のdevelopで入れ替える
  //   stop     止める
  //
  // **pollerへ渡すのはこの3語のどれかと`repositoryFullName`だけで、コマンドも
  // ポートも渡さない。** ポートは`scripts/local-repo-ports.conf`から、起動の仕方は
  // `scripts/start-preview-dev.sh`からpollerが決める（`INTERRUPT`・`KILL`が
  // セッション名を組み立て直すのと同じ作法で、任意のコマンドを流す口にしない）。
  previewAction      String?
  // 代行実行の終了コード（#1828）。`0`が成功で、画面はこれを見てチェックを付けるかを決める。
  // タイムアウトで打ち切った場合は`timeout`の終了コード（124）が入る。
  exitCode           Int?
  // 代行実行の出力（#1828。標準出力と標準エラーをまとめたもの）。**末尾を残して切る**
  // （エラーは最後に出るため）。
  //
  // **出力にはシークレットが混ざりうる。** ログイン必須のこの画面にだけ出し、GitHubのIssueにも
  // 通知にもpollerのログにも出さない。ここに残ること自体は、実行した結果を後から確かめる
  // 唯一の手掛かりであるため受け入れている。
  commandOutput      String?           @db.Text
  // 画面から失敗の表示を消した時刻（#1479）。入っている行は`GET /api/dispatch`が返さない。
  //
  // **行そのものは消さない。** 失敗理由（`message`）は後から原因を追うときの唯一の手掛かりで、
  // 表示を片付けたいだけの操作で履歴まで失わせない。終了したジョブは元々24時間で画面から
  // 落ちる（`FINISHED_JOB_RETENTION_MS`）ので、これはその24時間を待たずに畳むための印。
  //
  // **未完了のジョブには入れない**（`dismissDispatchJob`が弾く）。走っているものを表示だけ
  // 消せると、動いている実体が画面のどこにも出ないまま残る。止めたいなら取り消しを使う。
  dismissedAt        DateTime?
  // 順番待ちの中で先に払い出す度合い（#1541）。大きいほど先。既定は0で、同じ値なら
  // `createdAt`の昇順＝積んだ順に流れるため、**既存行の並びは変わらない**。
  //
  // 画面の「先頭へ上げる」（`prioritizeDispatchJob`）が、同じホストの`QUEUED`の最大値+1を
  // 入れる。**任意の並べ替えは持たない。** 主な用途が外出先のスマホで、ドラッグでの並べ替えは
  // 操作が難しいうえ、実際の要求は「これを次に流したい」の1点に尽きる。
  //
  // 払い出し（`claimDispatchJob`）と画面（`summarizeDispatchQueue`）は**同じ並び**で読む。
  // ここがずれると、画面に見えている順番と実際に走る順番が食い違う。
  queuePriority      Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([targetHost, status])
  @@index([targetHost, status, kind])
  @@index([targetHost, status, kind, queuePriority])
  @@index([repositoryFullName, issueNumber])
}

// ジョブを実行できるホストの申告（#1179）。サブPCが定期的にpushする。
//
// **「実行できるリポジトリの一覧」をここに持つのは、ジョブの割り当て可否を決める情報だから**
// （#1176のコメント）。ホストの死活・CPU・メモリ・tmuxセッション一覧はops-dashboard#34側の
// 担当で、issue-deckには持ち込まない。
//
// 申告は`scripts/subpc-dispatch-poller.sh`が`~/.config/issue-deck/local-repos.conf`を走査し、
// `scripts/start-local-session.sh`と同じ4つの検証を通ったものだけを載せる。判定を二重に
// 持たないよう、検証ロジックは`scripts/lib/local-repo-resolve.sh`で共有している。
model DispatchHost {
  id                       String   @id @default(cuid())
  name                     String   @unique
  // 実行可能と申告されたリポジトリのJSON配列（例: `["guchi-apps/issue-deck"]`）。
  // 数件しか無く、別テーブルにしてまで検索する必要が無いためテキストで持つ
  repositories             String   @db.Text
  // ホストの受け口が扱えるローカル起動プロトコルの上限版数
  // （src/lib/local-session.ts の LOCAL_SESSION_CONTRACT_VERSION と対応）
  contractVersion          Int?
  // ホスト側が申告する同時実行数の上限。AppSetting.dispatchConcurrencyとminを取る
  maxConcurrency           Int?
  // pollerのバージョン。受け口が古いまま動いているかの手掛かり
  agentVersion             String?
  // スクリーンショットを撮れるか（#1268）。Playwrightのブラウザ本体が入っているかで判定する。
  // **`null`は「申告していない」**（古いpoller）で、`false`（撮れない）とは区別する。
  // 無人実行では依存の追加をその場で確認する相手がいないため、撮れないホストで
  // `24.screenshot-required`を選ばせると必ず詰まる
  screenshotCapable        Boolean?
  // 走っているセッションを画面から操作できるか（#1332）。pollerが対応版で申告する。
  // **`null`（未申告＝古いpoller）は「できない」として扱う**。`screenshotCapable`とは逆で、
  // 判定材料が無いまま制御ジョブを配ると、古いpollerは`kind`を読まないため
  // **起動ジョブとして解釈してセッションを立てる**（「閉じる」を押して起動する）
  sessionControlCapable    Boolean?
  // 走っているセッションへ追加指示を流せるか（#1012）。3段階プロトコル
  // （状態確認 → 本文のみ送出 → 反映の再確認 → 確定キーを別送）を実装したpollerだけが申告する。
  // **`sessionControlCapable`とは別に持つ**。あちらは固定の`C-c`と`kill-session`しか送らないのに対し、
  // こちらは**内容のある文字列**を送るため、対応版でないpollerへ配ると事故の質が違う
  // （`null`＝未申告は「できない」として扱うのは同じ）
  instructionCapable       Boolean?
  // 複数リポジトリ横断の質問セッション（#1454）を起こせるか。`scripts/start-cross-repo-question.sh`を
  // 持つpollerだけが申告する。**`null`（未申告＝古いpoller）は「できない」として扱う**
  // （`sessionControlCapable`・`instructionCapable`と同じ向き。古いpollerへ配ると未知の種別として
  // `failed`になり、質問が必ず失われる）
  crossRepoQuestionCapable Boolean?
  // 手作業アシスタントからの代行実行（#1828）を実行できるか。`scripts/run-manual-step.sh`を
  // 持つpollerだけが申告する。**`null`（未申告＝古いpoller）は「できない」として扱う**
  // （`sessionControlCapable`・`instructionCapable`と同じ向き）。
  //
  // **`instructionCapable`とも分けて持つ。** あちらは走っているセッションの入力欄へ1行流すだけだが、
  // こちらは**シェルでコマンドを実行する**。対応していないpollerへ配ると未知の種別として`failed`に
  // なるだけだが、そもそも配ってよいホストかどうかの意味が違う
  manualStepCapable        Boolean?
  // 走っている代行実行を止められるか（#1882）。`MANUAL_STEP_ABORT`を扱えるpollerだけが申告する。
  // **`null`（未申告＝古いpoller）は「できない」として扱う**（`manualStepCapable`と同じ向き）。
  //
  // **`manualStepCapable`とは分けて持つ。** 代行実行を実行できるpollerでも、止める側の実装が
  // 入っているとは限らない。判定材料が無いまま中断ジョブを配ると未知の種別として`failed`になり、
  // 画面には「中断できなかった」だけが残る。申告を見て、止められないホストでは
  // 「打ち切りまで待つ」ことを先に案内する。
  manualStepAbortCapable   Boolean?
  // 埋めた値を差し込んで代行実行できるか（#2403）。`placeholderValues`を読んで`'…'`で包み、
  // 本文照合を通したテンプレートの穴へ差し込むpollerだけが申告する。
  // **`null`（未申告＝古いpoller）は「できない」として扱う**（`manualStepCapable`と同じ向き）。
  //
  // **`manualStepCapable`とは分けて持つ。** 古いpollerは知らないフィールドを黙って無視し、
  // `command`（＝`<…>`が入ったままのテンプレート）をそのまま実行してしまう。#2051が防いだ
  // 「`KEY=<値>`がリダイレクトとして解釈される」状態そのものなので、**申告が真でないホストへは
  // 値付きのジョブを払い出さない**（画面も理由を出して押させない）。
  manualStepValuesCapable  Boolean?
  // 計画の関門（G1・#1218）のセッションを起こせるか（#1855）。`scripts/start-plan-review.sh`を
  // 持つpollerだけが申告する。**`null`（未申告＝古いpoller）は「できない」として扱う**
  // （`crossRepoQuestionCapable`・`manualStepCapable`と同じ向き）。
  //
  // 計画レビューは**計画コメントの投稿を契機に自動で積まれる**ため、対応していないホストへ配ると
  // 計画のたびに`failed`のジョブが並ぶ。申告を見てから配る意味は他の種別より大きい。
  planReviewCapable        Boolean?
  // リポジトリ全体のコードレビュー（#698）のセッションを起こせるか。
  // `scripts/start-code-review.sh`を持つpollerだけが申告する。**`null`（未申告＝古いpoller）は
  // 「できない」として扱う**（`planReviewCapable`と同じ向き）。
  //
  // **`planReviewCapable`とは分けて持つ。** 走らせ方は似ているが、レビューは人が画面から押して
  // 起こすもので、対応していないホストへ配ると「押したのに`failed`だけが返る」ことになる。
  // 申告を見て、選べないホストは選択肢の側で理由を出す。
  codeReviewCapable        Boolean?

  // チェックアウトの更新と自己再起動ができるか（#1875）。`git pull --ff-only`のうえ
  // **自分で終了してsystemdの`Restart=always`に再起動させる**pollerだけが申告する。
  // **`null`（未申告＝古いpoller）は「できない」として扱う**（他のCapableと同じ向き）。
  //
  // **`manualStepCapable`とは分けて持つ。** 両方とも枠外で配る「セッションを立てない」ジョブ
  // （`OUT_OF_BAND_JOB_KINDS`）だが、手作業の代行に対応した既存のpollerは更新のジョブを知らず、
  // まとめて配ると未知の種別として`failed`になり、押した更新が失われる。
  selfUpdateCapable          Boolean?
  // 確認環境（#2444）を起こせるか。`scripts/start-preview-dev.sh`を持つpollerだけが申告する。
  // **`null`（未申告＝古いpoller）は「できない」として扱う**（他のCapableと同じ向き）。
  //
  // **`selfUpdateCapable`とは分けて持つ。** どちらも枠外で配る「セッションを立てない」ジョブ
  // （`OUT_OF_BAND_JOB_KINDS`）だが、更新に対応した既存のpollerは確認環境のジョブを知らず、
  // まとめて配ると未知の種別として`failed`になる。
  previewCapable             Boolean?
  // 確認環境を起こせるリポジトリのJSON配列（#2444）。**`repositories`の部分集合。**
  //
  // あちらは「セッションを起こせるか」で、こちらは「開発サーバーがあるか」。vps・subpc・docs・
  // claude-config・ideas はローカルセッションのためにポート帯だけ確保してあるが`package.json`が
  // 無く、確認環境としては起こせない。分けて持たないと、画面に押しても必ず失敗する行が並ぶ。
  // **`null`（未申告＝古いpoller）は「絞り込めない」**で、そのときは`repositories`をそのまま使う。
  previewRepositories        String?  @db.Text
  // セッション本数の上限（#1361）と、申告した時点で生きていた本数（#1394）。
  // **`AppSetting.dispatchConcurrency`とは別物**で、あちらはジョブの払い出しにしか効かない。
  // ジョブはtmuxセッションが立った時点で`succeeded`になるため、本数を止めているのはこちらだけ。
  //
  // 上限はホストの搭載メモリで決まる性質のものなのでアプリ設定には持たず、サブPCの
  // `dispatch.env`（`DISPATCH_MAX_SESSIONS`）が正。ここに持つのは**画面へ出すための写し**で、
  // 判定には使わない（サブPCのtmuxを見られるのはpollerだけで、こちらに判定を置くとずれる）。
  // **`null`は「申告していない」**（古いpoller）＝上限そのものが不明という意味で、
  // `liveSessions`が0であることとは区別する
  maxSessions                Int?
  liveSessions               Int?
  // 申告した時点のリソース使用率（#1567）。「もう1本セッションを起こしてよいか」を
  // issue-deckの画面だけで判断できるようにするための写しで、**判定には一切使わない**
  // （起動を止めているのは引き続き`maxSessions`と同時実行数）。
  //
  // **ホスト全体の監視はops-dashboardの担当のまま**で、ここに持つのはこの仕組みが
  // 起こすセッションの起動可否に効くもの（CPU・メモリ・SWAP・`/`のディスク）だけ。サービス・
  // プロセス・温度・ネットワーク・履歴はあちらにしか無い（境界は
  // `src/app/api/dispatch/hosts/route.ts`のコメント）。
  //
  // **`null`は「申告していない」**（古いpoller・取得に失敗した巡）で、0（空いている）とは
  // 区別する。5つは**まとめて入るかまとめてnullか**のどちらかで、部分的には埋まらない
  // （受け口の`parseDispatchHostMetrics`が全体を落とす）
  cpuPercent                 Float?
  memoryUsedMb               Int?
  memoryTotalMb              Int?
  diskUsedGb                 Float?
  diskTotalGb                Float?
  // SWAP（#1624）。**上の5つの「まとめて入るかまとめてnullか」には含めない。** SWAPを持たない
  // ホストとSWAPを申告しない古いpollerがどちらもありうるため、必須にするとCPU・メモリ・
  // ディスクごと消える。この2つは対で入るか、対でnullか。
  // **総量0（SWAPを持たない）はnullと区別する**（申告は届いている）が、画面ではどちらも
  // 行ごと出さない（`describeDispatchHostMetrics`）
  swapUsedMb                 Int?
  swapTotalMb                Int?
  // メモリ・SWAPが逼迫しているため、pollerが新しいセッションの起動ジョブを見送っている（#2095）。
  // **上の使用率と違い、これは写しであると同時にpollerの実際の動きそのもの。** 見送っている間
  // pollerは`maxJobs: 0`でclaimし、起動ジョブを取りに行かない（制御ジョブだけを受け取る）。
  //
  // 判定はpoller側が持つ（`DISPATCH_MEMORY_HOLD_PERCENT`・`DISPATCH_SWAP_HOLD_PERCENT`）。
  // **issue-deck側で判定し直さない。** 閾値はホストの搭載メモリで決まる性質のもので、
  // `maxSessions`と同じくサブPCの`dispatch.env`が正。
  //
  // 出さないと「順番待ちのまま進まない」としか見えず、pollerが落ちている状態と区別が付かない
  // （#1394と同じ問題）。3列は**まとめて入るかまとめてnullか**で、`null`は「見送っていない」
  // （または見送りを申告しない古いpoller）。
  //
  //   launchHoldReason           `MEMORY`（メモリ）か`SWAP`。どちらも超えていればメモリを出す
  //   launchHoldPercent          判断に使った使用率（0〜100）。上の`memoryUsedMb`等と同じ巡の値
  //   launchHoldThresholdPercent 超えた閾値（0〜100）
  launchHoldReason           String?
  launchHoldPercent          Float?
  launchHoldThresholdPercent Float?
  // pollerが動かしているチェックアウトの鮮度（#1612）。**`agentVersion`とは別物**で、
  // あちらは約束を変えたときに手で上げるプロトコル版数、こちらは実際に走っているスクリプトが
  // どのコミットのものかという事実。
  //
  // pollerが動かすのは自分と同じチェックアウト（`SCRIPT_DIR`基準）のスクリプトで、これを
  // 自動で更新する仕組みは無い。**`develop`へマージしただけでは効かない**のに、効いていない
  // ことに気付く手掛かりがどこにも無かった（2026-08-15には97コミット遅れており、#1454と
  // #1541がどちらもサブPCでは一度も働いていなかった）。
  //
  // **`null`は「申告していない」**（古いpoller・gitが無い・チェックアウトを読めなかった巡）。
  // `checkoutBehind`だけは別に`null`になりうる（fetchできず、遅れを数えられなかった場合）。
  // 数えた遅れがいつ時点のものかは`checkoutFetchedAt`（最後にoriginを見た時刻）で分かる
  checkoutCommit             String?
  checkoutBranch             String?
  checkoutCommittedAt        DateTime?
  checkoutBehind             Int?
  checkoutFetchedAt          DateTime?
  // いま動いている確認環境（#2444）。**同時に1つだけ**なので、別テーブルにせずホストの列で持つ。
  //
  // サブPCの実効RAMは13Giしかなく、#1523ではIssueごとの開発サーバーの孤児9本でOOM Killerが
  // 発動している。リポジトリ数ぶんの確認環境を常駐させる前提は置けないため、**起こせるのは
  // 1つ**で、別のリポジトリを選んだら前のものを止めてから起こす（判定はpoller側。
  // `scripts/start-preview-dev.sh`が他のポートのserveも撤去する）。
  //
  // **`checkout*`と同じく画面へ出すためだけの写しで、判定には使わない。** 実体はサブPCの
  // プロセスとPIDファイル（`~/apps/<repo>-worktrees/.dev-servers/preview.pid`）で、こちらは
  // 30秒ごとの申告で置き換わる。**`null`は「動いていない」と「申告していない」の両方**を
  // 兼ねるが、区別が要るのは`previewCapable`の側なのでここでは分けない。
  //
  //   previewRepository    `owner/repo`。動いていなければnull
  //   previewBranch        映しているブランチ（develop / main）
  //   previewPort          待ち受けているポート（`scripts/local-repo-ports.conf`の帯 + 0）
  //   previewUrl           tailnetのURL。`tailscale serve`が使えないホストではnull
  //   previewCommit        映しているコミット（短縮SHA）
  //   previewSubject       そのコミットの1行目
  //   previewStartedAt     起こした時刻
  //   previewIdleMinutes   何分アクセスが無ければ自動停止するか（`DEV_SERVER_IDLE_MINUTES`）
  previewRepository          String?
  previewBranch              String?
  previewPort                Int?
  previewUrl                 String?
  previewCommit              String?
  previewSubject             String?  @db.Text
  previewStartedAt           DateTime?
  previewIdleMinutes         Int?
  // 最後に申告が届いた時刻。一定時間途絶えたホストはoffline扱いでenqueueを拒否する
  lastSeenAt                 DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 起動後のtmuxセッションの状態（#1217）。サブPCのpollerが1巡ごとに報告する。
//
// **DispatchJobを伸ばさず別のモデルにしているのは、寿命が違うため。** ジョブは「起動の記録」で
// tmuxセッションが立った時点でSUCCEEDEDになり終わる（`run_job()`がそう報告する）。そこへ
// セッションの生存を混ぜると、未完了ジョブを1件に制限しているactiveKeyの意味が壊れる。
//
// **画面（capture-pane）の内容は持たない。** 実装中のコード・環境変数が映りうるうえ、画面の
// 文字列から状態を推定する方式は既に実地で誤判定している（#1219・#1223）。入力待ち・完了・停滞は
// Claude Codeのフックが担当し（#1219）、こちらはフックが飛ばない「プロセスの死・消失」だけを見る。
model DispatchSession {
  id                 String                @id @default(cuid())
  // 報告してきたホスト名（DispatchHost.nameと対応）
  host               String
  tmuxSessionName    String
  repositoryFullName String
  issueNumber        Int
  state              DispatchSessionState
  // 異常終了したときの終了コード（tmuxの`#{pane_dead_status}`）。原因の手掛かりとして残す
  exitStatus         Int?
  firstSeenAt        DateTime
  lastReportedAt     DateTime
  // どの状態で引き上げ済みか。pollerは60秒ごとに同じ報告を送るため、これが無いと毎分コメントが増える。
  // FAILED以外へ移ったらnullへ戻し、復帰後に再び落ちた場合の2回目を拾えるようにする
  escalatedState     DispatchSessionState?
  escalatedAt        DateTime?

  // セッション自身がフック（#1219）から報告してくる直近の様子（#1264）。pollerが見ている
  // tmuxのメタデータでは分からない「人の入力を待っているか」を、画面へ出すために持つ。
  //
  // **古い値が残り続けないことが前提。** WAITING_INPUTはStopフック（RESPONDEDへ遷移）で解ける。
  // セッションが消えた場合は表示側が状態を優先するだけで値は残るため、同じ名前で立ち上がり直した
  // 行では報告の受け口（reportDispatchSessions・isRevivedSession）が捨てる（#1353）。
  activity         DispatchSessionActivity?
  activityAt       DateTime?
  // claude --remote-control が表示するURL。スマホから答えるための唯一の出口なので画面に出す。
  // 取れないこともある（Claude Codeの内部ファイル依存）
  remoteControlUrl String?                  @db.Text
  // tailscale serveでtailnetへ出した開発サーバーのURL（#1265）。スマホから画面を見る唯一の
  // 出口なので画面へ出す。`23.preview-required`が付いたセッションでだけ埋まる
  previewUrl       String?                  @db.Text

  // このセッションを自動で畳む予定（#1817）。**サブPCの`scripts/reap-sessions.sh`が
  // 「畳む条件はすべて揃っていて、あとは猶予が経つのを待っているだけ」と判定したときだけ埋まる。**
  //
  // 判定材料（worktreeがcleanか・コミットがpush済みか）はサブPCのファイルシステムにしか無く、
  // issue-deck側では同じ判定を組み立てられない。**ここは運ばれてきた結論を持つだけで、
  // 画面はこれを「あと何分で自動終了」に直して出す**（`lib/dispatch/issue-session.ts`）。
  //
  // NULLは「畳む予定が無い（作業中・入力待ち・条件を満たしていない）」で、pollerが毎巡
  // 上書きする。理由は文言ではなくコード（`PR_MERGED`など）で、文言は画面側に置く
  reapAt     DateTime?
  reapReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([host, tmuxSessionName])
  @@index([state])
}

// ALIVE=ペインが生きている / EXITED=正常終了して残っている / FAILED=異常終了して残っている /
// GONE=報告に含まれなくなった（セッションが消えた）。
//
// **引き上げるのはFAILEDだけ。** GONEは人が作業を終えて畳んだ場合と区別が付かず、むしろ
// そちらの方が多いため、鳴らすとノイズになって本当の異常終了が埋もれる。
// セッション自身がフックから報告してくる様子（#1264）。
//
// WAITING_INPUT=承認プロンプト・AskUserQuestionで人の入力を待っている /
// WORKING=その入力に人が答え、作業へ戻った（#1357） /
// RESPONDED=応答が終わった（無人で回すセッションでは実質「作業完了」）。
//
// **WORKINGはRESPONDEDでは代用できない。** RESPONDEDは「応答を終えています／次の指示を待って
// いる場合があります」と出るため、答えた直後の作業中に送ると誤った表示になる（#1357）。
//
// **停滞・完了の判定には使わない。** これは「今この瞬間セッションが何をしているか」で、
// 実装の進捗はProject Statusが唯一の正（docs/progress-status-architecture.md）。
//
// NOT_STARTED=Claude Code本体がまだ開始していない（#1465）。**これだけはフックではなく
// pollerが立てる。** 初めてクローンしたリポジトリではフォルダの信頼確認で止まり、
// セッションが始まっていないためフックが1つも飛ばず、画面には何も出ないまま操作が止まる。
enum DispatchSessionActivity {
  WAITING_INPUT
  WORKING
  RESPONDED
  NOT_STARTED
}

enum DispatchSessionState {
  ALIVE
  EXITED
  FAILED
  GONE
}

// 手作業アシスタントの自動実行（#1869）の状態（#1882）。
//
// RUNNING=次の1件を積んでよい／PAUSED=止まっている（理由は`pausedReason`）／
// FINISHED=流すものが無くなった（クローズは人が押す）／STOPPED=人が中断した。
enum ManualStepRunStatus {
  RUNNING
  PAUSED
  FINISHED
  STOPPED
}

// 自動実行が止まっている理由（#1882）。**画面の出し分けと、再開してよいかの判断に使う。**
//
// USER=代行できない項目に来た（人が実行して「実行した・次へ」を押すと続きから流れる）/
// FAILED=実行が失敗した・打ち切られた（原因を直してから再開する）/
// ENQUEUE_FAILED=積めなかった（ホストが居ない・本文が変わった等。理由は`message`）。
enum ManualStepRunPause {
  USER
  FAILED
  ENQUEUE_FAILED
}

// 手作業アシスタントの自動実行1本（#1882）。
//
// **#1869では「状態を持つのは画面だけ」にしていた**（サーバー・DBに置くと、画面を閉じた後に
// 誰が実行を進めるのかを決める必要が出るため）。#1882で「自動実行中に画面を閉じたい・進行状況を
// 確認したい」という要望を受け、**進めるのはサーバー**（代行実行の結果報告を受けた時点で次の
// 1件を積む）と決めてここへ移した。画面は状態を読んで出すだけになり、ブラウザを閉じても
// 別の端末から開いても、同じ1本の実行を追える。
//
// **1つのIssueにつき1行**（`@@unique`）。次に同じ手作業を流すときは同じ行を上書きする。
// 「いつ何を実行したか」の履歴は`DispatchJob`側に残るので、ここに履歴を溜める必要が無い。
//
// **DispatchJobへ外部キーは張らない**（`DispatchJob`がRepositoryへ張っていないのと同じ理由で、
// 寿命が違うため）。`currentJobId`は画面が結果を引き当てるための手掛かり。
model ManualStepRun {
  id                 String              @id @default(cuid())
  repositoryFullName String
  issueNumber        Int
  // 積む先のホスト名（DispatchHost.nameと対応）。**開始した時点のホストに固定する**
  targetHost         String
  status             ManualStepRunStatus @default(RUNNING)
  pausedReason       ManualStepRunPause?
  // この実行で流し終えた行番号のJSON配列（例: `[12,18]`）。**チェックの付かない確認コマンドを
  // 二度流さないための記録。** 手順のチェックはIssue本文が正で、ここには持たない
  doneLines          String              @db.Text
  // 失敗したときに出力をClaudeへ送ってよいか（承認パネルのチェック。#1869）
  diagnoseConsent    Boolean             @default(true)
  // 承認した人（User.id）。Userを消しても実行の記録は残すためFKは張らない
  startedByUserId    String?
  // いま積んでいる（または最後に積んだ）代行実行ジョブのid
  currentJobId       String?
  // 止まった理由・中断の結果など、**画面にそのまま出す前提**の一文
  message            String?             @db.Text
  startedAt          DateTime            @default(now())
  finishedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([repositoryFullName, issueNumber])
  @@index([status])
}

// 定期巡回の結果（#2008）。**PASSED＝「完了済みの可能性」で、完了そのものではない。**
//
// RUNNING=確認コマンドを順に流している最中 / PASSED=全部が終了コード0で終わった /
// FAILED=どれかが0以外だった（＝まだ実施されていないと読む。ふつうの状態） /
// UNAVAILABLE=流せなかった（ホストが居ない・積めなかった・打ち切った）。
enum ManualStepVerificationStatus {
  RUNNING
  PASSED
  FAILED
  UNAVAILABLE
}

// openな手作業Issueの`## 完了の確認方法`を、人の操作なしに定期実行した結果（#2008）。
//
// 手作業の完了判定が「人がクローズを押す」ことだけに依存していると、**実行したのに押し忘れた
// ものに誰も気づけない**（#1994が実例）。確認コマンドを1日1回流し、全部通ったIssueに
// 「完了済みの可能性」の印を出して、押す機会を画面へ戻す。
//
// **1つのIssueにつき1行**（`@@unique`。`ManualStepRun`と同じ形）。前回の巡回の結果は
// 上書きし、履歴は`DispatchJob`側に残る。**流したコマンドの出力はここに持たない**——
// 出力にはシークレットが混ざりうるため、置き場は`DispatchJob.commandOutput`の1か所に留める
// （#1828「出力は画面にだけ出す」）。
model ManualStepVerificationCheck {
  id                 String                       @id @default(cuid())
  repositoryFullName String
  issueNumber        Int
  // 積む先のホスト名（DispatchHost.nameと対応）。巡回のたびに選び直す
  targetHost         String
  status             ManualStepVerificationStatus @default(RUNNING)
  // この巡回で流し終えた行番号のJSON配列（`ManualStepRun.doneLines`と同じ形）
  doneLines          String                       @db.Text
  // いま積んでいる（または最後に積んだ）代行実行ジョブのid
  currentJobId       String?
  // 止まった理由。**画面には出さない**（巡回は人が始めたものではないため、失敗を通知しない）
  message            String?                      @db.Text
  startedAt          DateTime                     @default(now())
  finishedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([repositoryFullName, issueNumber])
  @@index([status])
}

model IssueLabel {
  id            String  @id @default(cuid())
  issueId       String
  githubLabelId BigInt?
  name          String
  color         String
  description   String?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, name])
  @@index([githubLabelId])
}

enum SecretSyncRunStatus {
  QUEUED
  SUCCEEDED
  FAILED
  TIMEOUT
}

/// 1Password → GitHub のシークレット同期を画面のボタンから起こしたときの1実行1行（#1309）。
///
/// issue-deckはsecretを書かない。ここに残るのは「いつ・どのリポジトリへ・どの項目を対象に
/// 起動したか」と、対象リポジトリのActionsから報告された**件数と失敗した項目名だけ**。
/// **値そのものも値の長さも保存しない**（長さも手がかりになる）。
model SecretSyncRun {
  id                 String              @id @default(cuid())
  repositoryFullName String
  // 対象を絞ったKEYのカンマ区切り。空文字はマニフェスト全件を意味する
  only               String              @default("")
  status             SecretSyncRunStatus @default(QUEUED)
  // 画面から起こしたユーザー（User.id）。Userを消しても履歴は残すためFKは張らない。
  // Actionsタブから直接起動された実行の報告を受けた場合はnull
  requestedByUserId  String?
  startedAt          DateTime            @default(now())
  finishedAt         DateTime?
  syncedCount        Int                 @default(0)
  skippedCount       Int                 @default(0)
  failedCount        Int                 @default(0)
  // 失敗した項目の**名前だけ**をカンマ区切りで持つ
  failedKeys         String              @db.Text
  // 同期した項目・スキップした項目の**名前だけ**をカンマ区切りで持つ（#2022）。
  // 「何の値が同期されたのか」を画面に出すためで、ここも**値そのものも値の長さも持たない**。
  // 既存の行と、項目名を報告しない古いタグの共有ワークフローからの報告では空文字になる
  syncedKeys         String              @db.Text
  skippedKeys        String              @db.Text
  runUrl             String?
  // 画面にそのまま出す説明文（報告が来ないまま時間切れになった場合の理由など）
  message            String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 「このリポジトリの最新の実行」を引くのが画面・クールダウン判定・報告の突き合わせの
  // すべてで共通の読み方
  @@index([repositoryFullName, startedAt])
}

// ローカルセッションが`ExitPlanMode`で出した計画に対する、画面からの返事（#2061）。
//
// **`send-keys`は使わない。** 計画を投稿している`PreToolUse(ExitPlanMode)`フック
// （`scripts/session-notify.sh`）が、投稿のあとそのままここの`status`が決まるのを待ち、
// 決まった内容をClaude Code自身の許可判定（`permissionDecision`）として返す。承認プロンプトの
// 選択フォームに答えさせる操作はどこにも無いため、`docs/multi-agent/gates.md`の禁止に触れない。
//
// WAITING=画面の返事を待っている／APPROVED=承認された（`allow`を返す）／
// REVISION_REQUESTED=修正が送られた（`deny`＋`revisionText`を返す）／
// DEFERRED=「端末で答える」を押された／EXPIRED=待ち時間が切れた。
// 後ろの3つはどれも「何も返さずに終える」で、端末に従来どおりの承認ダイアログが出る。
model SessionPlanRequest {
  id                 String                   @id @default(cuid())
  repositoryFullName String
  issueNumber        Int
  // 報告してきたホスト名（DispatchHost.nameと対応）。取れないこともある
  hostName           String?
  // 画面に出す計画本文。Issueコメントにも同じものが残っているが、**コメントの取得に
  // 依存させない**（画面はディスパッチの状態と同じ1本のポーリングでこれを読む）
  plan               String                   @db.Text
  status             SessionPlanRequestStatus @default(WAITING)
  // 修正の本文（REVISION_REQUESTEDのときだけ）。そのままClaudeへ渡る
  revisionText       String?                  @db.Text
  // 画面から押したユーザー（User.id）。Userを消しても履歴は残すためFKは張らない
  decidedByUserId    String?
  decidedAt          DateTime?
  // ここを過ぎたらフックは待つのをやめる。画面のカウントダウンもこれを見る
  expiresAt          DateTime
  // フックが結論を受け取った時刻。**受け取ったあとに押しても届かない**ことを画面へ出す
  deliveredAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([repositoryFullName, issueNumber])
  @@index([status, expiresAt])
}

enum SessionPlanRequestStatus {
  WAITING
  APPROVED
  REVISION_REQUESTED
  DEFERRED
  EXPIRED
}

/// ローカルセッションが`AskUserQuestion`で聞いた質問への、画面からの回答待ち（#2189）。
///
/// **`SessionPlanRequest`（#2061）の質問版で、作りは同じ。** 計画の承認と別テーブルにして
/// あるのは、待っている中身が「1本のテキスト」と「選択肢つきの質問の配列」で違い、1つの行に
/// 両方を持たせると画面もフックもどちらなのかを毎回見分けることになるため。
///
/// 受け取るのは質問を投げた`PreToolUse(AskUserQuestion)`フック（`scripts/session-notify.sh`）で、
/// 決まった回答は`updatedInput.answers`としてClaude Codeへ返る。**端末へキーを送る経路は
/// 持たない**（docs/multi-agent/gates.md）。
model SessionQuestionRequest {
  id                 String                       @id @default(cuid())
  repositoryFullName String
  issueNumber        Int
  // 報告してきたホスト名（DispatchHost.nameと対応）。取れないこともある
  hostName           String?
  // `AskUserQuestion`の`questions`をそのまま入れたJSON文字列。画面はこれを描き、
  // フックへ返すときも**受け取ったままの形**で`updatedInput`へ添え直す（#2121と同じ作法）
  questions          String                       @db.Text
  status             SessionQuestionRequestStatus @default(WAITING)
  // 送られた回答のJSON文字列（ANSWEREDのときだけ）。`{"質問文": "選んだラベル"}`で、
  // 複数選択は`, `で連結する（Claude Code側の受け取り方に合わせる）
  answers            String?                      @db.Text
  // 画面から押したユーザー（User.id）。Userを消しても履歴は残すためFKは張らない
  decidedByUserId    String?
  decidedAt          DateTime?
  // ここを過ぎたらフックは待つのをやめる。画面のカウントダウンもこれを見る
  expiresAt          DateTime
  // フックが回答を受け取った時刻。**受け取ったあとに押しても届かない**ことを画面へ出す
  deliveredAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([repositoryFullName, issueNumber])
  @@index([status, expiresAt])
}

enum SessionQuestionRequestStatus {
  WAITING
  ANSWERED
  DEFERRED
  EXPIRED
}

/// PRの自動修復（`claude-ci-fix.yml`・`claude-conflict-resolve.yml`・`claude-pr-repair.yml`）が
/// いま走っているかどうか（#2072）。
///
/// **1つのPR×1つの種別につき1行**（`@@unique`）で、次の実行は同じ行を上書きする。履歴は
/// GitHub ActionsとIssue・PRのコメントに残るため、ここで持つのは「いまの状態」だけでよい。
///
/// 状態を報告するのはワークフロー側（`POST /api/pull-requests/repair-runs`）と、画面のボタンから
/// 起動する`POST /api/pull-requests/repair`の2経路。**GitHub APIからは引けない**——自動検知で
/// 起動した実行は`workflow_run`イベント発の実行で、`head_branch`・`head_sha`が対象PRではなく
/// デフォルトブランチを指すため、実行から対象PRへ辿る手段が無い。
model PullRequestRepairRun {
  id                 String    @id @default(cuid())
  repositoryFullName String
  pullRequestNumber  Int
  /// `RepairKind`（`ci` / `conflict`）。DB側では文字列で持ち、解釈はアプリ側に寄せる
  kind               String
  /// `running`（実行中） / `finished`（終わった）。**画面に出すのは`running`だけ**で、
  /// `finished`は「もう走っていない」ことを表すために残す
  status             String
  /// 実行ログのURL。画面のボタンから起動した直後はまだrunが決まらないためnull
  runUrl             String?
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryFullName, pullRequestNumber, kind])
  @@index([status])
}

/// ローカル・サブPC実行のセッションが公開したアーティファクト（#2154）。
///
/// **claude.aiのアーティファクトページは`content-security-policy: frame-ancestors 'self'`を
/// 返すため、URLをそのままiframeへ入れられない**（実測）。代わりに公開した時点で
/// `PostToolUse(Artifact)`のフックがHTMLの原本を送ってきて、issue-deck自身のオリジンから
/// 出す。ここが持つのはその原本の在り処と、カードに出す最小限の見出し。
///
/// **1つのIssue×1つのソースファイルにつき1行**（`@@unique`）。アーティファクトは同じ
/// ファイルパスへ再公開すると同じURLになる（claude.aiの仕様）ので、揃えて上書きする。
/// 履歴は持たない——見たいのは常に最新の見た目で、過去の版はclaude.ai側の版一覧にある。
model SessionArtifact {
  id                 String  @id @default(cuid())
  repositoryFullName String
  issueNumber        Int
  /// 公開したセッションのホスト名（DispatchHost.nameと対応）。取れないこともある
  hostName           String?
  /// アーティファクトの見出し。`<title>`かファイル名から決まる（フック側が送ってくる）
  title              String  @db.Text
  /// ギャラリーの副題として送られてきた説明。無いことの方が多い
  description        String? @db.Text
  /// タブのアイコンに使う絵文字。無ければ画面側で既定を出す
  favicon            String?
  /// claude.aiのアーティファクトURL。**アプリ内で開けなかったときの逃げ道**として画面に出す
  claudeUrl          String? @db.Text
  /// フックが読んだHTMLファイルのパス（worktree内）。再公開の同一判定に使う
  sourcePath         String  @db.Text
  /// `sourcePath`の同一判定用ハッシュ。MySQLのインデックスは`TEXT`に直接張れない
  sourceKey          String
  /// `uploads/artifacts/`配下の保存ファイル名（中身のSHA-256 + `.html`）。
  /// **内容が同じなら同じ名前**なので、同じ公開が2回届いても余分なファイルが残らない
  storedFilename     String
  /// 保存したHTMLのバイト数。画面には出さないが、取りこぼしの調査に効く
  byteSize           Int

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([repositoryFullName, issueNumber, sourceKey])
  @@index([repositoryFullName, issueNumber])
}

/// ブラウザのPush購読1件（#838）。**端末×ブラウザごとに1行**で、ユーザーごとではない。
/// 同じ人がPCとスマホの両方で受け取れば2行になる。
///
/// 保存するのは`PushSubscription.toJSON()`が返すものと同じ3つ（送信に要るのはこれだけ）。
/// `endpoint`はPushサービスが払い出すURLで、これ自体が宛先の識別子なので一意にする
/// （同じ端末から登録し直したときは行が増えず上書きされる）。
model PushSubscription {
  id          String  @id @default(cuid())
  userId      String
  /// Pushサービスの宛先URL。長いのでTEXTで持ち、一意判定はハッシュ（endpointKey）で行う
  endpoint    String  @db.Text
  /// `endpoint`のSHA-256。MySQLのインデックスはTEXTに直接張れないため一意キーはこちら
  endpointKey String  @unique
  /// 暗号化に使う購読側の公開鍵（`keys.p256dh`）
  p256dh      String  @db.Text
  /// 暗号化に使う認証シークレット（`keys.auth`）
  auth        String  @db.Text
  /// 登録した端末の`navigator.userAgent`。設定画面で「どの端末か」を見分けるためだけに使う
  userAgent   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 本番デプロイ（`deploy.yml`）の失敗を追跡するために自動起票したIssue（#2236）。
///
/// **デプロイ失敗はこれまで通知1件と赤いバッジにしか残らなかった。** `deploy-retry.yml`の
/// 自動再実行（#2134）で直らない失敗は、人が気づいて「本番へ再デプロイ」を押すまで本番が
/// 古い版のまま残る。盤面に載るIssueとして残せば、他の作業と同じ場所に並んで消えない。
///
/// この表が持つのは**起票したかどうか**だけで、失敗そのものの正はGitHubのrun。
/// 二重起票を防ぐ鍵に`runId`を使う（同じrunの再検知では起票しない）。
model DeployFailureIssue {
  id                 String @id @default(cuid())
  repositoryFullName String
  /// 失敗した`deploy.yml`のrun id。**同じrunで二重に起票しないための鍵**
  runId              BigInt
  /// 起票したIssueの番号
  issueNumber        Int
  /// `open` / `closed`。後続のデプロイが成功した時点で`closed`にする
  state              String @default("open")
  /// 失敗した版（`4.14.0`）。特定できなければnull
  version            String?
  /// 失敗したrunのURL。画面から実行ログを開くのに使う
  runUrl             String @db.Text

  detectedAt DateTime  @default(now())
  /// 自動でクローズした時刻。人が先に閉じた場合はnullのまま`closed`になる
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryFullName, runId])
  @@index([repositoryFullName, state])
}

/// 本番へのマージ待ち（develop→mainのリリースPR）をPush通知した記録（#2376）。
///
/// **Push通知は「もう鳴らしたか」をプロセスの外に持つ必要がある。** 巡回の再実行そのものは
/// 冪等だが、通知は再実行すると鳴る。本番はPM2の`max_memory_restart`で落ちることがあり
/// （`deploy/ecosystem.config.js`・#2331）、プロセス内に持つと再起動のたびに鳴り直す
/// （`public/sw.js`は`renotify: true`で出すので、同じ`tag`でも静かには置き換わらない）。
/// 確認待ちのPushが`Issue.checkUserPushSentAt`に席を取っている（#2300）のと同じ役割で、
/// リリースPRはIssueに紐づかないため別の表にしている。
///
/// 持つのは**いつ鳴らしたか**だけで、マージ待ちかどうかの正はGitHubのPR。
/// 鍵は`repositoryFullName` + `pullRequestNumber`（`DeployFailureIssue`の`runId`と同じ考え方）。
/// マージ・クローズされたPRの行は次の巡回が消すので、平常時は数行しか残らない。
model ReleaseMergePushNotice {
  id                 String @id @default(cuid())
  repositoryFullName String
  /// マージ待ちのリリースPRの番号。**同じPRで鳴らし続けないための鍵**
  pullRequestNumber  Int
  /// 最後に鳴らした時刻。ここから再通知までの間隔を測る
  notifiedAt         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryFullName, pullRequestNumber])
  @@index([repositoryFullName])
}
