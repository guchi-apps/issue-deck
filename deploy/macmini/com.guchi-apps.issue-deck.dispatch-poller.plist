<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac mini のディスパッチpoller（#5528）。サブPCの deploy/subpc/issue-deck-dispatch-poller.service に当たる。
  launchdはパスの `~` や `%h` を展開しないため、__HOME__ はインストール時に置き換える
  （deploy/macmini/README.md の手順を参照）。

  - 設定（DISPATCH_SECRET など）は ~/.config/issue-deck/dispatch.env から run-with-env.sh が読む。
    このファイルを変更したら `launchctl kickstart -k gui/$(id -u)/com.guchi-apps.issue-deck.dispatch-poller` が要る。
  - tmuxサーバーはデーモン化して別のプロセスグループになるため、pollerを止めても
    走っている実装セッションは巻き添えにならない。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.guchi-apps.issue-deck.dispatch-poller</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bash</string>
    <string>-lc</string>
    <string>exec "$HOME/apps/issue-deck/deploy/macmini/run-with-env.sh" "$HOME/apps/issue-deck/scripts/subpc-dispatch-poller.sh"</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- GNU版のコマンドとbash 5を、macOS標準のBSD版より先に見つけさせる -->
    <key>PATH</key>
    <string>/opt/homebrew/opt/coreutils/libexec/gnubin:/opt/homebrew/opt/util-linux/bin:/opt/homebrew/bin:/opt/homebrew/sbin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>LANG</key>
    <string>ja_JP.UTF-8</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__HOME__</string>

  <key>RunAtLoad</key>
  <true/>
  <!-- systemdの Restart=always / RestartSec=30s に当たる -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- journaldの代わり。`tail -f ~/Library/Logs/issue-deck/dispatch-poller.log` で読む -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/issue-deck/dispatch-poller.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/issue-deck/dispatch-poller.log</string>
</dict>
</plist>
