# Mac mini のディスパッチpoller・wake receiverの設定（#5528）。
#
# **項目と意味はサブPCと同じ。** 各項目の説明は deploy/subpc/dispatch.env.example を正とし、
# ここには Mac mini で値が変わるもの・必ず埋めるものだけを置く。
# 調整したい項目があれば、あちらから行を写して追記する。
#
# 置き場所: ~/.config/issue-deck/dispatch.env（chmod 600）
#   launchdは EnvironmentFile= を持たないため、deploy/macmini/run-with-env.sh が読み込む。
#   書式はサブPCと同じ `KEY=値`（`export` は付けない）。
#
#   install -m 600 deploy/macmini/dispatch.env.example ~/.config/issue-deck/dispatch.env
#
# 実値はリポジトリに置かない。1Password（apps/issue-deck）から書き出す（手順は
# deploy/subpc/dispatch.env.example のコメントと同じ）。

# issue-deckのURL。本番を指す。
APP_BASE_URL=https://example.invalid

# ディスパッチAPIの共有シークレット（サブPCと同じ値）。
DISPATCH_SECRET=

# 進捗報告の共有シークレット（サブPCと同じ値）。空だとIssueの進捗が動かない（#1236）。
PROGRESS_REPORT_SECRET=

# **このホストの名前は必ず明示する。** 省略時の `hostname -s` は macOS では
# 端末名から自動で付いた名前になり、画面の表記（MacMini）と結び付かない。
# 識別子は status-hub のホスト統計と揃えて `macmini` にする。
DISPATCH_HOST_NAME=macmini

# ジョブ即時通知の受け口（wake receiver）。tailnet上の Mac mini のアドレスを書く。
# 0.0.0.0 などの全インターフェースは受信側が起動を拒否する。
WAKE_LISTEN_ADDR=
#WAKE_LISTEN_PORT=4290

# 生かしておく実装セッションの上限。Mac mini（メモリ16GB）では5本程度を目安にし、
# 既定（12）より低くする。メモリ不足でホストごと止まった例がある（サブPC・2026-08-14）。
DISPATCH_MAX_SESSIONS=5

# --- 手作業Issueの代行実行（#5568） ---
# サブPC・Mac miniのどちらでも手作業の代行・巡回を受けられる。**VPSの手順（`（VPS）`）を
# Mac miniから代行するには、次を埋める**（空のままだと manualStepVps=false を申告し、
# VPSの手順はサブPC側にしか配られない）。値と意味はサブPCと同じ
# （deploy/subpc/dispatch.env.example の MANUAL_STEP_VPS_SSH_TARGET 周辺を参照）。
# Mac miniからVPSへ Tailscale SSH で入れることを `ssh <ターゲット> true` で確かめてから設定する。
#MANUAL_STEP_VPS_SSH_TARGET=github-user@example-vps.tailnet.ts.net
#MANUAL_STEP_VPS_SSH_CONNECT_TIMEOUT=15
#MANUAL_STEP_VPS_PROBE_INTERVAL_MINUTES=5
#MANUAL_STEP_TIMEOUT_SECONDS=300
#MANUAL_STEP_OUTPUT_MAX_CHARS=8000

# 1台でよい手作業・定期巡回を、サブPCとMac miniの両方がオンラインのときにどちらへ配るか。
# 小さい数のホストが先（未設定は最後尾。同順位はホスト名順）。サブPCにも同じ項目を書いて揃える。
#DISPATCH_HOST_PRIORITY=1
