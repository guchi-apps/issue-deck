[Unit]
# ディスパッチpollerの起動間隔（#1179）。
#
# **timer方式を採っているのは、落ちても次の発火で復帰するのが単純だから。**
# 常駐ループにすると、クラッシュ時の再起動と多重起動の防止を自前で持つことになる。
#
# 60秒間隔のポーリングでissue-deck側にかかる負荷は、1分あたりHTTP 2回・DBクエリ数件で
# 無視できる（申告と claim をまとめて1巡で行う）。
Description=issue-deck dispatch poller を定期実行する
Documentation=https://github.com/guchi-apps/issue-deck/blob/develop/docs/multi-agent/subpc-dispatch.md

[Timer]
# 起動直後に1回（申告をすぐ届け、ホストがofflineのままにならないようにする）
OnBootSec=1min
OnUnitActiveSec=60s
# 前回の実行が長引いた場合、終わってから60秒後に次を出す（重ならない）
AccuracySec=10s
Unit=issue-deck-dispatch-poller.service

[Install]
WantedBy=timers.target
