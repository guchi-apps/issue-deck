# 実装セッションの状態通知（scripts/session-notify.sh）の設定（#1219）。
#
# 置き場所: ~/.config/issue-deck/notify.env
#   ISSUE_DECK_NOTIFY_ENV で別の場所を指定することもできる。
#
# **必ず chmod 600 にする。** webhookのURLはそれ自体が投稿権限を持つシークレット。
#
#   install -D -m 600 deploy/subpc/notify.env.example ~/.config/issue-deck/notify.env
#
# 実値はリポジトリに置かない。1Password（apps/issue-deck）の session-webhook-url から
# 次のように書き出す（サブPCはGUIが無いためサービスアカウント方式。#1177）。
#
#   WH=$(op read "op://apps/issue-deck/session-webhook-url") || exit 1
#   [ -n "$WH" ] || exit 1
#   printf 'SESSION_NOTIFY_WEBHOOK_URL=%s\n' "$WH" >> ~/.config/issue-deck/notify.env
#
# **代入を `export` と分けること・`2>&1` を付けないことが重要。**
# `export WH=$(op read ... 2>&1)` と書くと、(a) 返るのは `export` の終了コードなので
# op の失敗を検出できず、(b) エラーメッセージが値に混入し、そのまま webhook URL として
# 書き込まれる（#1231で実際に踏んだ）。中間ファイル（/tmp 等）を介さないのも、
# 消す前に他ユーザーから読まれうるため。
#
# 書き出したら、必ず1度は手で発火させて届くことを確認する。設定が壊れていても
# フック経由では黙って続行してしまうため、確認しないと壊れていることに気づけない。
# 手順は docs/multi-agent/session-notify.md の「セットアップ」を参照。
#
# **このファイルが無い、またはURLが空の場合は通知を行わず、セッションはそのまま起動する。**
# 通知を使わないPC（メインPC等）でも同じスクリプトがそのまま動くようにするため。
#
# ディスパッチpollerの設定（dispatch.env）とは別ファイルにしている。あちらはsystemdの
# EnvironmentFile= がpollerのプロセスへ渡すもので、こちらはフックのプロセスが自分で読む。
# 読む主体も更新のタイミングも別なので、1つにまとめない。

# セッション通知用のSignaly webhook URL（1Passwordの session-webhook-url）。
# **CI/デプロイ通知（.github/*.env.tpl の SIGNALY_WEBHOOK_URL = ci-webhook-url）とは
# 別チャンネル・別フィールド。** 同じ値を入れない。理由は
# docs/multi-agent/session-notify.md の「CI/デプロイ通知とチャンネルを分ける」を参照。
SESSION_NOTIFY_WEBHOOK_URL=

# 計画を出したあと、issue-deckの画面からの返事を何秒まで待つか（#2061）。**省略可**（既定1800＝30分）。
#
# 待っている間は端末に承認プロンプトが出ず、画面（Issue詳細の「計画の承認を待っています」）
# からだけ承認・修正を送れる。待ち切ると従来どおりのプロンプトが端末に出るので、設定を
# 変えても壊れない。`0`にすると待たず、従来どおりの動きになる。
# 60〜3600の範囲へissue-deck側が丸める。
#SESSION_PLAN_WAIT_SECONDS=1800
