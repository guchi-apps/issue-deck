# サブPCのディスパッチpoller（scripts/subpc-dispatch-poller.sh）の設定（#1179）。
#
# 置き場所: ~/.config/issue-deck/dispatch.env
#   ISSUE_DECK_DISPATCH_ENV で別の場所を指定することもできる。
#   systemdのserviceが EnvironmentFile= で読むため、`export` は付けない。
#
# **必ず chmod 600 にする。** 共有シークレットの実値を置くファイル。
#
#   install -D -m 600 deploy/subpc/dispatch.env.example ~/.config/issue-deck/dispatch.env
#
# 実値はリポジトリに置かない。1Password（apps/issue-deck）から次のように書き出す
# （サブPCはGUIが無いためサービスアカウント方式。#1177）。
#
#   op read "op://apps/issue-deck/dispatch-secret" > /tmp/s && \
#     printf 'DISPATCH_SECRET=%s\n' "$(cat /tmp/s)" >> ~/.config/issue-deck/dispatch.env && rm -f /tmp/s
#
# 毎分の実行のたびに `op run` を挟まないのは、1Password CLIの起動コストが
# ポーリング間隔に対して重すぎるため。値の更新時に書き出し直す運用にしている。

# issue-deckのURL。**本番を指す。** ジョブが積まれるのは本番のDBだけで、
# ローカルの開発サーバーを指しても画面から積んだジョブは取れない。
APP_BASE_URL=https://example.invalid

# ディスパッチAPIの共有シークレット。issue-deck側の環境変数 DISPATCH_SECRET と同じ値。
# 進捗報告の PROGRESS_REPORT_SECRET とは**別の値**（あちらは全リポジトリのActionsから
# 参照できるorganization secretで、ジョブを取れる権限まで載せない）。
DISPATCH_SECRET=

# 進捗報告（POST /api/progress）の共有シークレット。**ここが空だと、このホストで起動した
# セッションはIssueの進捗（Project Status）を一切動かさない**（#1236）。
#
# ランチャー（issue-deck自身の scripts/start-issue.sh と汎用ランチャー scripts/generic-start-issue.sh）は
# 起動時にProject Statusを`Implementation`（`21.plan-required`なら`Planning`）へ報告する。
# 宛先と鍵は 環境変数 → issue-deck本体チェックアウトの `.env.local` → このファイル の順に探す。
# **サブPCのチェックアウトはアプリを動かすためのものではないため、`.env.local` のキーは
# 空のことがある。** そのぶんサブPCでは実質ここが唯一の置き場になる。
#
# 値は1Passwordから書き出す。`DISPATCH_SECRET`とは**別の値**。
#
#   op read "op://apps/issue-deck/progress-report-secret" > /tmp/s && \
#     printf 'PROGRESS_REPORT_SECRET=%s\n' "$(cat /tmp/s)" >> ~/.config/issue-deck/dispatch.env && rm -f /tmp/s
#
# 未設定でも起動は止まらず、進捗の報告だけがスキップされる（画面から手で進められる）。
# pollerは起動時に1度だけ、見つからなければjournaldへ警告を出す。
PROGRESS_REPORT_SECRET=

# このホストの名前。省略すると `hostname -s` を使う。
# issue-deckの画面には、ここで申告した名前が起動先として並ぶ。
#DISPATCH_HOST_NAME=subpc

# 1巡で取りに行く最大本数。実際に払い出される本数は、issue-deck側の設定
# （アプリ設定の「サブPCの同時実行数」）が上限として効く。
#DISPATCH_MAX_JOBS=1

# 生かしておく実装セッションの上限。省略時は12（#1361）。
#
# **「同時実行数」とは別物。** あちらは1度に何本"起動"するかで、tmuxが立った時点でジョブは
# `succeeded`になる。生きているセッションの本数には効かないため、これが無いと本数は
# 単調に増える。回収（SESSION_IDLE_MINUTES）は「判定できなければ畳まない」設計で、
# IssueがOPENのセッションや人の入力待ちのセッションは正当に残り続けるためである。
#
# 2026-08-14にサブPCで34本まで積み上がり、メモリ枯渇でホストごと停止した
# （SSHもコンソールも応答せず、Magic SysRqでの再起動が要った）。
#
# 上限に達している間、pollerはジョブを取りに行かず、理由をjournaldへ出す。
# **積んだジョブは消えない**（QUEUEDのジョブは期限切れの対象外）。回収で空きができた
# 次の巡でそのまま起動する。
#
# 値はホストの搭載メモリで決める。サブPC（13.9GB）では実測で1セッション約390MBに加え、
# 開発サーバーが最大3本走るため、12本で1〜2割の余裕が残る見当。
#DISPATCH_MAX_SESSIONS=12

# ポーリング間隔（秒）。省略時は60。
# **ここが「画面のボタンを押してから起動が始まるまでの待ち時間」を決める。**
# 実運用で許容できるかは動かしてみないと分からないため、コードにもsystemdのunitにも
# 埋め込まず設定値にしてある（#1179）。短くするとissue-deckへのリクエストが増えるが、
# 1回あたりHTTP 2回・DBクエリ数件なので、数十秒の範囲なら負荷は問題にならない。
#DISPATCH_POLL_INTERVAL_SECONDS=60

# 1件の起動に掛ける上限（秒）。省略時は900（15分）。
# 起動が固まったときにポーリングごと止まらないようにするための保険。
#DISPATCH_LAUNCH_TIMEOUT_SECONDS=900

# 開発サーバー（`pnpm dev`）をアイドルとみなすまでの分数。省略時は60。**0で無効**（#1223）。
#
# pollerは1巡ごとに scripts/reap-dev-servers.sh を呼び、次の2つを回収する。
#
#   - 孤児   セッションを畳んでも残っている開発サーバー（この分数とは無関係に即回収する）
#   - アイドル この分数のあいだ `.dev-servers/issue-<番号>.log` が更新されていない開発サーバー。
#             **セッション本体は残す**（追加指示で同じセッションを再利用する運用のため）
#
# `next dev` はリクエストと再コンパイルのたびにログへ書くため、mtimeが「誰もその画面を見ていない」
# 時間の代理になる。短くしすぎると、画面を触らずに実装しているセッションの開発サーバーまで
# 止まる（止めた理由と起こし方はログの末尾に残るため、`pnpm dev`で起こし直せる）。
#DEV_SERVER_IDLE_MINUTES=60

# 作業が終わった実装セッション（tmuxセッションと`claude`プロセス）を畳むまでの猶予（分）。
# 省略時は60。**0で無効**（#1256）。
#
# pollerは1巡ごとに scripts/reap-sessions.sh を呼び、次の条件を**すべて**満たすセッションだけを
# `tmux kill-session`で畳む。1つでも欠ければ畳まず、理由をjournaldへ残す。
#
#   1. pollerがジョブとして起動したセッションである（手元のターミナルから直接起動した分は対象外）
#   2. ペインが生きている（死んだペインは異常終了の証拠なので、最後の出力を読めるよう残す）
#   3. 最後のフックのイベントが`Stop`（`permission_prompt`が後なら人の入力待ち、
#      `working`が後ならそれに答えて作業中）
#   4. その`Stop`からこの分数が経っている
#   5. Issueに`11.local`が付いていない（実装エージェントが引き渡し時に自分で外すラベル）
#   6. IssueがCLOSED、または`issue-<番号>`のPRがマージ済み
#   7. worktreeに未コミットの変更が無く、コミットがすべてoriginにある
#
# **畳むと文脈が失われる。** マージ後に追加指示が来て同じセッションを再利用した実例（#1178）が
# あるため、短くしすぎない。畳まれた後に追加指示が必要になったら、画面から起動し直す。
#SESSION_IDLE_MINUTES=60
