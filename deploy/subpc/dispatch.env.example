# サブPCのディスパッチpoller（scripts/subpc-dispatch-poller.sh）の設定（#1179）。
#
# 置き場所: ~/.config/issue-deck/dispatch.env
#   ISSUE_DECK_DISPATCH_ENV で別の場所を指定することもできる。
#   systemdのserviceが EnvironmentFile= で読むため、`export` は付けない。
#
# **必ず chmod 600 にする。** 共有シークレットの実値を置くファイル。
#
#   install -D -m 600 deploy/subpc/dispatch.env.example ~/.config/issue-deck/dispatch.env
#
# 実値はリポジトリに置かない。1Password（apps/issue-deck）から次のように書き出す
# （サブPCはGUIが無いためサービスアカウント方式。#1177）。
#
#   op read "op://apps/issue-deck/dispatch-secret" > /tmp/s && \
#     printf 'DISPATCH_SECRET=%s\n' "$(cat /tmp/s)" >> ~/.config/issue-deck/dispatch.env && rm -f /tmp/s
#
# 毎分の実行のたびに `op run` を挟まないのは、1Password CLIの起動コストが
# ポーリング間隔に対して重すぎるため。値の更新時に書き出し直す運用にしている。

# issue-deckのURL。**本番を指す。** ジョブが積まれるのは本番のDBだけで、
# ローカルの開発サーバーを指しても画面から積んだジョブは取れない。
APP_BASE_URL=https://example.invalid

# ディスパッチAPIの共有シークレット。issue-deck側の環境変数 DISPATCH_SECRET と同じ値。
# 進捗報告の PROGRESS_REPORT_SECRET とは**別の値**（あちらは全リポジトリのActionsから
# 参照できるorganization secretで、ジョブを取れる権限まで載せない）。
DISPATCH_SECRET=

# 進捗報告（POST /api/progress）の共有シークレット。**ここが空だと、このホストで起動した
# セッションはIssueの進捗（Project Status）を一切動かさない**（#1236）。
#
# ランチャー（issue-deck自身の scripts/start-issue.sh と汎用ランチャー scripts/generic-start-issue.sh）は
# 起動時にProject Statusを`Implementation`（`21.plan-required`なら`Planning`）へ報告する。
# 宛先と鍵は 環境変数 → issue-deck本体チェックアウトの `.env.local` → このファイル の順に探す。
# **サブPCのチェックアウトはアプリを動かすためのものではないため、`.env.local` のキーは
# 空のことがある。** そのぶんサブPCでは実質ここが唯一の置き場になる。
#
# 値は1Passwordから書き出す。`DISPATCH_SECRET`とは**別の値**。
#
#   op read "op://apps/issue-deck/progress-report-secret" > /tmp/s && \
#     printf 'PROGRESS_REPORT_SECRET=%s\n' "$(cat /tmp/s)" >> ~/.config/issue-deck/dispatch.env && rm -f /tmp/s
#
# 未設定でも起動は止まらず、進捗の報告だけがスキップされる（画面から手で進められる）。
# pollerは起動時に1度だけ、見つからなければjournaldへ警告を出す。
PROGRESS_REPORT_SECRET=

# このホストの名前。省略すると `hostname -s` を使う。
# issue-deckの画面には、ここで申告した名前が起動先として並ぶ。
#DISPATCH_HOST_NAME=subpc

# 1巡で取りに行く最大本数。実際に払い出される本数は、issue-deck側の設定
# （アプリ設定の「サブPCの同時実行数」）が上限として効く。
#
# **同時実行数を2から3へ上げた後も1のまま据え置いている**（#1812）。1巡で1本しか取りに来ない
# ため、まとめて投入すると3本目が立つのはポーリング間隔（DISPATCH_POLL_INTERVAL_SECONDS・
# 既定30秒）の2巡後になる。積んだジョブが消えるわけではないので害はない。
#
# 2以上にしても短くなるのはこのポーリング間隔ぶんだけで、**起動そのものは速くならない。**
# pollerは取得したジョブを直列に起動し、1本ぶんの起動（worktree作成・依存インストール）は
# 冷えていると数分かかる（LAUNCH_TIMEOUTの既定が15分なのはそのため）。その間は次の巡へ進めず、
# 申告・セッションの回収・停止／終了の制御ジョブの受け取りがまとめて待たされる。
# 数十秒を縮めるために数分の応答性を落とす取引になるので、上げていない。
#DISPATCH_MAX_JOBS=1

# 生かしておく実装セッションの上限。省略時は12（#1361）。
#
# **「同時実行数」とは別物。** あちらは1度に何本"起動"するかで、tmuxが立った時点でジョブは
# `succeeded`になる。生きているセッションの本数には効かないため、これが無いと本数は
# 単調に増える。回収（SESSION_IDLE_MINUTES）は「判定できなければ畳まない」設計で、
# IssueがOPENのセッションや人の入力待ちのセッションは正当に残り続けるためである。
#
# 2026-08-14にサブPCで34本まで積み上がり、メモリ枯渇でホストごと停止した
# （SSHもコンソールも応答せず、Magic SysRqでの再起動が要った）。
#
# 上限に達している間、pollerはジョブを取りに行かず、理由をjournaldへ出す。
# **積んだジョブは消えない**（QUEUEDのジョブは期限切れの対象外）。回収で空きができた
# 次の巡でそのまま起動する。
#
# この値と現在の本数は申告（POST /api/dispatch/hosts）でissue-deckへ送られ、実行キューと
# Issue詳細に出る（#1394）。**割り当ての判定はpoller側のまま**で、あちらは表示にしか使わない。
#
# 値はホストの搭載メモリで決める。サブPC（13.9GB）では実測で1セッション約390MBに加え、
# 開発サーバーが最大3本走るため、12本で1〜2割の余裕が残る見当。
#
# **同時実行数を2から3へ上げた後も12のまま据え置く**（#1812）。ここは搭載メモリ基準の値で、
# メモリは13Giのまま変わっていない。「開発サーバーが最大3本」という見当も同時実行数の上限
# （実測でも3本が上限）と一致したままなので置き直す必要が無い。
#
# **余裕が残ることは実測の条件そのもので確かめている。** 3本並行の計測（guchi-apps/subpc#19）は
# 他に7〜10本のClaude Codeセッションが動いている状態で行い、同時ビルド中もswapは0だった。
# つまり「3本が同時にビルド中 ＋ 合計12本前後のセッション」が載る。4本目で初めてswapに落ちる。
#DISPATCH_MAX_SESSIONS=12

# 同時に走らせる計画レビュー（G1・#1855）の上限。省略時は2。
#
# **上の本数とは別に持つ。** 計画レビューのセッション名は`-issue-`の規約から外してあり
# （そうしないとセッションの報告・停止／終了の突き合わせに混ざる）、そのぶん
# DISPATCH_MAX_SESSIONS の計上からも外れる。ジョブもセッションが立った時点で閉じるため、
# ここで止めないと同時に何本でも走る。上限に達している間に届いたレビューは「見送り」として
# 記録され、画面の「計画をレビュー」から起こし直せる。
#DISPATCH_MAX_PLAN_REVIEWS=2

# メモリ・SWAPが逼迫している間、新しいセッションの起動ジョブを取りに行かないための閾値（%）。
# 省略時はメモリ85・SWAP50。**どちらも0で無効**（その項目では見送らない）。#2095
#
# **上の DISPATCH_MAX_SESSIONS が見ているのは本数だけで、実際の空きメモリではない。**
# 12本に届いていなくても重い作業（テスト・ビルド）が重なっていれば、そこへさらにセッションを
# 足してしまう。2026-08-14にはメモリ枯渇でホストごと停止した（Magic SysRqでの再起動が要った）。
#
# pollerは1巡の入口で集めた使用率（画面に出ているものと同じ値）がこの割合以上なら、
# その巡の起動ジョブを`maxJobs: 0`で見送る。**停止・追加指示などの制御ジョブは従来どおり取る**
# （本数の上限に達したときと同じ形）。積んだジョブは消えず、余力が戻った次の巡で起動する。
#
# 見送っていることは申告（POST /api/dispatch/hosts）でissue-deckへ送られ、実行キューと
# スマホのホームのホストの行、Issue詳細の順番待ちの理由に出る。出さないと「順番待ちのまま
# 進まない」としか見えず、pollerが落ちている状態と区別が付かない（#1394と同じ問題）。
#
# 既定のメモリ85%は、画面の使用率が赤くなる境目（issue-deckの`src/lib/dispatch/host-metrics.ts`の
# `CRITICAL_PERCENT`）に合わせてある。**見た目の警告と実際の見送りを同じ線に置く**ためで、
# 別の値にすると「赤いのに起動する」「赤くないのに止まっている」が起きる。値を変えるときは
# 向こうも見ること。SWAPの50%は、平常時（実装セッション6本前後）の実測が20%程度であることから。
#
# **使用率を取れなかった巡は見送らない。** 余力が分からないことを止める理由にすると、
# `/proc`が読めないだけで起動が永久に止まる。
#DISPATCH_MEMORY_HOLD_PERCENT=85
#DISPATCH_SWAP_HOLD_PERCENT=50

# ポーリング間隔（秒）。省略時は30（#1624で60から短くした）。
# **ここが「画面のボタンを押してから起動が始まるまでの待ち時間」と「実行キューに出る
# 使用率の古さ」を決める。**
# 実運用で許容できるかは動かしてみないと分からないため、コードにもsystemdのunitにも
# 埋め込まず設定値にしてある（#1179）。短くするとissue-deckへのリクエストが増えるが、
# 1回あたりHTTP 2回・DBクエリ数件なので、数十秒の範囲なら負荷は問題にならない。
#DISPATCH_POLL_INTERVAL_SECONDS=30

# チェックアウトの遅れを数え直す間隔（分）。省略時は360（6時間）。**0で無効**（#1612）。
#
# pollerが動かすのは自分と同じチェックアウト（`~/apps/issue-deck`）の`reap-sessions.sh`・
# `reap-dev-servers.sh`・ランチャーで、**これを自動で更新する仕組みは無い**。`develop`へ
# マージしただけでは挙動が変わらないのに、変わっていないことに気付く手掛かりがどこにも
# 無かった（2026-08-15には97コミット遅れており、#1454と#1541がどちらもマージ済みなのに
# 一度も効いていなかった）。
#
# pollerはこの間隔で`git fetch --quiet origin`を打ち、HEADが追跡ブランチから何コミット
# 遅れているかを申告する（POST /api/dispatch/hosts）。実行キューとスマホのホーム画面の
# ホストの行に「develop fbb809d・97コミット遅れ」として出る。
#
# **申告するだけで`git pull`はしない**（docs/multi-agent/gates.md）。取り込むかどうかは人が
# 決める。取り込み方は docs/multi-agent/subpc-dispatch.md を参照。
#
# 毎巡fetchしないため、遅れの数字は最後にoriginを見た時点のもの。その時刻も一緒に申告し、
# 12時間より古ければ画面に「◯時間前時点」と注記が出る。0にすると一切fetchしなくなり、
# 人が手で`git pull`したときだけ数字が更新される（画面は「遅れ不明」になりうる）。
#DISPATCH_CHECKOUT_FETCH_INTERVAL_MINUTES=360

# 1件の起動に掛ける上限（秒）。省略時は900（15分）。
# 起動が固まったときにポーリングごと止まらないようにするための保険。
#DISPATCH_LAUNCH_TIMEOUT_SECONDS=900

# 開発サーバー（`pnpm dev`）をアイドルとみなすまでの分数。省略時は20。**0で無効**（#1223）。
#
# pollerは1巡ごとに scripts/reap-dev-servers.sh を呼び、次の2つを回収する。
#
#   - 孤児   セッションを畳んでも残っている開発サーバー（この分数とは無関係に即回収する）
#   - アイドル この分数のあいだ `.dev-servers/issue-<番号>.log` が更新されていない開発サーバー。
#             **セッション本体は残す**（追加指示で同じセッションを再利用する運用のため）
#
# `next dev` はリクエストと再コンパイルのたびにログへ書くため、mtimeが「誰もその画面を見ていない」
# 時間の代理になる。短くしすぎると、画面を触らずに実装しているセッションの開発サーバーまで
# 止まる（止めた理由と起こし方はログの末尾に残るため、`pnpm dev`で起こし直せる）。
#
# **省略時を60から20へ短くしたのが#2076。** 開発サーバーは1本で最大1.6GiBまで育ち、実装セッションは
# 最大12本同時に生きている（`DISPATCH_MAX_SESSIONS`）。60分ぶん抱えたままだとメモリが尽き、
# `earlyoom`が`next-server`をkillする状態が繰り返し起きていた。起こし直しは実測0.3秒。
#DEV_SERVER_IDLE_MINUTES=20

# PIDファイルに載っていない孤児を止めるまでの猶予（分）。省略時は30。**0で無効**（#1525）。
#
# 上の DEV_SERVER_IDLE_MINUTES と同じ scripts/reap-dev-servers.sh（pollerが1巡ごとに呼ぶ）が使う
# 値だが、効くのは**在庫の取り方が違う経路**。
#
#   - PIDファイル（`.dev-servers/issue-<番号>.pid`）から入る経路 … 孤児（PPID==1）とアイドル
#   - `/proc`の走査から入る経路 … 上の在庫に**載っていない**開発サーバー
#
# 後者は、実装エージェントが案内どおり手で `pnpm dev` と起こし直した2本目を拾うためにある。
# あれはPIDファイルにもログにも載らないため、セッションが畳まれても存在自体が見えず、
# 誰も止めないまま残り続けていた（2026-08-15のOOMの原因。#1523）。
#
# tmuxセッション（`<repo>-issue-<番号>`）が無く、かつ起動からこの分数が経っているものだけを止める。
# 猶予は「セッションが立つ前の開発サーバーを撃たない」ためのもので、**唯一の誤爆の防波堤**。
# 短くしすぎると起動中のセッションを巻き込む。
#DEV_SERVER_ORPHAN_GRACE_MINUTES=30

# 作業が終わった実装セッション（tmuxセッションと`claude`プロセス）を畳むまでの猶予（分）。
# 省略時は5。**0で無効**（#1256・既定は#1649で60から下げた）。
#
# pollerは1巡ごとに scripts/reap-sessions.sh を呼び、次の条件を**すべて**満たすセッションだけを
# `tmux kill-session`で畳む。1つでも欠ければ畳まず、理由をjournaldへ残す。
#
#   1. pollerがジョブとして起動したセッションである（手元のターミナルから直接起動した分は対象外）
#   2. ペインが生きている（死んだペインは異常終了の証拠なので、最後の出力を読めるよう残す）
#   3. 最後のフックのイベントが`Stop`（`permission_prompt`が後なら人の入力待ち、
#      `working`が後ならそれに答えて作業中）
#   4. その`Stop`から猶予が経っている（条件6のどの経路で畳むかで見る値が違う。下記）
#   5. Issueに`11.local`が付いていない（実装エージェントが引き渡し時に自分で外すラベル）
#   6. IssueがCLOSEDか`issue-<番号>`のPRがマージ済みで、この分数が経っている。または
#      PRがopenで存在し SESSION_HANDOFF_IDLE_MINUTES が経っている（#1541）
#   7. worktreeに未コミットの変更が無く、コミットがすべてoriginにある
#
# **条件4と6は経路ごとに独立している**（#1649）。CLOSED・マージ済みはこの値だけ、引き渡し済みは
# SESSION_HANDOFF_IDLE_MINUTES だけを見る（以前は両方を満たす必要があり、実効が
# max(SESSION_IDLE_MINUTES, SESSION_HANDOFF_IDLE_MINUTES) になっていた）。
# ただし**この値の0だけは「回収そのものを行わない」の意味**で、引き渡し済みの経路も止まる。
#
# ただし**横断質問セッションは条件5〜7を見ない**。worktreeもPRも持たないため、代わりに
# 「質問IssueがCLOSED、またはOPENのまま QUESTION_SESSION_IDLE_MINUTES を超えた」で決める
# （#1454・#1648）。条件4の猶予もそちらの値を使う。
#
# 畳まれた後に追加指示が必要になったら、画面から起動し直す。**前回の会話の続きから再開する**
# （#1541。worktreeは残るので `claude --continue` がそのcwdの直前の会話を拾う）。
# **質問セッションだけは引き継がない**（#1648。cwdが質問Issue間で共有されるため、残っている
# 会話が同じ質問のものとは限らない）。
#SESSION_IDLE_MINUTES=5

# 引き渡し済み（PRを作り`11.local`も外した）セッション専用の猶予。省略時は5
# （#1541・既定は#1649で30から下げた）。**0にすると、この経路だけを無効にできる**
# （従来どおりマージまで残す）。
#
# 上の条件6の3つ目に対応する。マージまで残すと、人の確認待ちのPR（`00.check-user`・
# `22.merge-confirm-required`）を抱えたセッションが DISPATCH_MAX_SESSIONS を埋めて、
# 夜にまとめて積んだ後続のジョブが流れなくなる。
#
# 以前は「引き渡し済みにだけCI失敗の指摘が返る余地がある」という理由でCLOSED・マージ済みより
# 長めに取っていたが、サブPCでの実測（1.7日・134件）で**畳んだ後に呼び戻したケースが1件も
# 無かった**ため、段差を取り下げた（#1649）。畳んでもworktreeは残り、`--continue`で前回の会話の
# 続きから再開できる。
#SESSION_HANDOFF_IDLE_MINUTES=5

# APIエラー（529 Overloaded など）で中断したセッションの自動再開（#1971）。**0で無効。**
#
# Claude Codeは一時エラーを既定10回（ランチャーは15回に上げている）まで再試行し、使い切ると
# そのturnを打ち切る。**このとき`Stop`フックが飛ばない**ため、Signalyにも画面にも何も出ず、
# 状態ファイルは`working`のまま止まり、回収も画面の「追加指示を送る」も効かない。
# 2026-08-18には6セッションが同時にこれで止まり、人が端末から「続けて」と打つまで5時間半
# 動かなかった。
#
# pollerは1巡ごとに、生きている実装セッションのうち
#
#   - 転記（`~/.claude/projects/.../<sessionId>.jsonl`）の最後のレコードがAPIエラーである
#   - その転記が SESSION_RESUME_STALL_MINUTES 分のあいだ更新されていない
#
# ものを見つけ、**固定の1行**（「直前の応答がAPIエラーで中断しました。…」）を
# 画面の「追加指示を送る」と同じ3段階プロトコルで送る。承認プロンプト・選択フォームの表示中、
# 処理中、入力欄に打ちかけがある場合は送らない。
#
# SESSION_RESUME_MAX_ATTEMPTS 回試しても復帰しなければ送るのをやめ、Signalyへ1度だけ通知して
# 人へ渡す（そこから先はRemote Controlか端末で続ける）。
#SESSION_RESUME_ENABLED=1

# 転記が更新されないまま経ったら「中断している」とみなす分数。省略時は10。
# **短くすると、エラーの直後に自力で書き始めたturnへ割り込む。**
#SESSION_RESUME_STALL_MINUTES=10

# 1セッションあたり自動で再開を試みる上限回数。省略時は3。
#SESSION_RESUME_MAX_ATTEMPTS=3

# 再開を試みる間隔（分）。省略時は5。過負荷が続いている間に連打しても同じことになるため間を置く。
#SESSION_RESUME_INTERVAL_MINUTES=5

# worktreeを掃除する間隔（分）。省略時は60。**0で無効**（#1716）。
#
# pollerはこの間隔で scripts/cleanup-worktrees.sh --yes を呼び、消しても失われるものが無い
# worktreeとローカルブランチを削除する。判定は従来どおりスクリプト側にあり、pollerは呼ぶだけ。
#
# **これまで実行の起点がどこにも無かった。** スクリプトは#1100からあったのに、ユーザーcrontabも
# systemd timerも無く、`start-issue.sh`は案内を出すだけだった。サブPCの稼働開始（2026-08-13）から
# 3日でworktreeが181本・38GBまで溜まり、ルートFSが77%（残り23GB）に達した。増加ペースは
# 約12〜13GB/日で、放置すれば2日で尽きる計算だった。うち177本は削除対象になりうる状態で、
# 足りなかったのは判定ではなく起点。
#
# 掃除は `git fetch` と `gh pr list` を1回ずつ叩き、worktreeの本数ぶんの走査を行う。170本で
# 数十秒かかる（#1680の改善後）ため、毎巡（30秒ごと）ではなくこの間隔で呼ぶ。**走っている間
# ポーリングは止まる**（上限5分で打ち切る）。
#
# 掃除は次のものを消さない。`start-issue.sh` がworktreeを作ってからセッションのプロセスが
# 立つまでの数分間を守るため、**起動の準備から30分が経っていないworktreeも対象外**（#1716。
# `ISSUE_DECK_CLEANUP_MIN_AGE_MINUTES`で変えられる）。
#
#   - 未コミットの変更があるもの・origin/developに入っていないコミットがあるもの
#   - セッション・開発サーバーが動いているもの
#
# 併せて、**残すworktreeの `.next` は削除する**（ビルド成果物で作り直せるため）。実測で
# worktree 163本が `.next/dev` だけで16GBを抱えていた。
#WORKTREE_CLEANUP_INTERVAL_MINUTES=60

# 横断質問セッション（#1454）専用の猶予。省略時は30（#1648）。
# **0にすると、この経路だけを無効にできる**（従来どおり質問IssueがCLOSEDになるまで残す）。
#
# 質問セッションには「終わった」と分かる事実（PR・マージ）が無く、**質問Issueを閉じるまで
# 永久に残る**設計だった。追い質問を送らないまま忘れられたぶんがそのまま DISPATCH_MAX_SESSIONS を
# 埋めるため、質問IssueがOPENのままでもこの分数の放置で畳む。
#
# 実装セッション（SESSION_IDLE_MINUTES）より短くてよいのは、質問セッションがworktreeも
# コミットも持たず、**畳んでも失うのは会話の文脈だけ**（回答コメントは質問Issueに残る）のため。
# 猶予を待たずに今すぐ畳みたいときは、画面のIssue詳細のセッション表示の「終了」を押す
# （Issueはopenのまま残る）。
#QUESTION_SESSION_IDLE_MINUTES=30

# 手作業の代行実行（#1828）を打ち切るまでの秒数。省略時は300（5分）。
#
# 手作業アシスタントの「承認して実行」で積まれたコマンドを、scripts/run-manual-step.sh が
# この秒数で打ち切る（`timeout`）。**画面には「5分で打ち切ります」と出ているので、変えるなら
# issue-deck側の MANUAL_STEP_TIMEOUT_SECONDS（src/lib/manual-step-command.ts）と揃える。**
#
# ジョブのheartbeatタイムアウト（10分）より短くしておくこと。長くすると、打ち切る前に
# ジョブがタイムアウト扱いになり、実行結果が画面へ返らなくなる。
#MANUAL_STEP_TIMEOUT_SECONDS=300

# 代行実行の出力のうち、画面へ返す長さ（文字数）。省略時は8000。**末尾を残して切る**
# （エラーは最後に出るため）。issue-deck側の受け口でも同じ長さで切り直す。
#
# 出力はログイン必須の画面にだけ出す（GitHubのIssueにも通知にもjournaldにも出さない）。
# **シークレットが混ざりうる**ため、長くするほど残る量も増える。
#MANUAL_STEP_OUTPUT_MAX_CHARS=8000
