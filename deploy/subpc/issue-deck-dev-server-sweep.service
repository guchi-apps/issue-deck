[Unit]
# 孤児の開発サーバーの定期掃除（#1525・#1523の子）。ポートを掴んだまま残った`pnpm dev`を、
# PIDファイルに依らず`ss -tlnp`から探して止める。
#
# **pollerが1巡ごとに呼ぶ scripts/reap-dev-servers.sh とは別の段**（多層防御）。あちらの入口は
# `.dev-servers/issue-<番号>.pid`だけで、PIDファイルが残らなかった孤児と、pollerそのものが
# 落ちている場合を取りこぼす。ここはpollerと独立した経路で動く。
Description=issue-deck orphan dev server sweep
Documentation=https://github.com/guchi-apps/issue-deck/blob/develop/docs/multi-agent/local-quick-start.md

[Service]
Type=oneshot

# 猶予（DEV_SERVER_ORPHAN_GRACE_MINUTES）はpollerと同じ設定ファイルから読む。
# **無くても動く**（`-`付き）。設定を置く場所を増やさないためだけの共有で、
# このunitはDISPATCH_SECRETを使わない。
EnvironmentFile=-%h/.config/issue-deck/dispatch.env

# systemd配下にはログインシェルのPATHが無い。`ss`・`tmux`・`logger`はシステム側にあるが、
# 経路をpollerのunitと揃えておく（#1177・#1178と同じ理由）。
ExecStart=/bin/bash -lc '%h/apps/issue-deck/scripts/sweep-orphan-dev-servers.sh'

# 掃除の失敗はホストの異常ではない（判定できなければ何もしない作り）。次の発火で拾い直せるため、
# 再起動もリトライもさせない。
