# アプリ実行時に参照する環境変数（値は空。ローカルは .env.local.example を参照）
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App（インストール連携。App JWT署名用）
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
NEXT_PUBLIC_GITHUB_APP_SLUG=

# ユーザー本人のGitHub OAuthアクセストークンの暗号化用鍵（base64エンコードされた32byte）
GITHUB_USER_TOKEN_ENCRYPTION_KEY=

# ユーザー本人のGitHub OAuthアクセストークン失効時、refresh_tokenによる自動延長に使う
# （Supabase AuthのGitHubプロバイダー設定と同一のClient ID/Secretを設定する必要がある）。
# 未設定でもアプリは動作し、自動延長機能のみ無効化される（現状どおり再ログイン導線にフォールバック）
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ログインを許可するメールアドレス（カンマ区切り）
ALLOWED_EMAILS=

# GitHub Webhook（署名検証用シークレット）
GITHUB_WEBHOOK_SECRET=

# Actionsの消費量（設定▸状態）の取得に使うトークン。**classicのOAuthトークン・PATが要る**
# （GitHub Appのインストールトークン・ユーザートークンでは403になる。#2212）。
# スコープは`repo`（または`admin:org`）。未設定の場合は当該表示のみ無効化される。
GITHUB_BILLING_TOKEN=

# Claudeプラン使用量の表示用。`claude setup-token`で発行する長期トークン。
# 未設定の場合は当該表示のみ無効化され、アプリ自体は動作する。
CLAUDE_CODE_OAUTH_TOKEN=

# アプリ内AI機能でGPTモデルを選択した場合に使用するOpenAI APIキー。
# 未設定の場合もClaudeモデルは引き続き使用できる。
OPENAI_API_KEY=

# Push通知（#838。アプリを閉じているときの確認待ちの知らせ）で使うVAPID鍵。
# 3つ揃っていないとPush通知の機能だけが無効になり、他の機能には影響しない。
# 生成: npx web-push generate-vapid-keys
# VAPID_SUBJECT は連絡先。`mailto:<メールアドレス>` かアプリのURLを入れる。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# smee.io経由でローカルにWebhookを転送するためのチャンネルURL（ローカル開発でのみ使用）
GITHUB_WEBHOOK_PROXY_URL=

# Supabase Authを経由せずログイン済み状態を再現するためのバイパス用シークレット
# （src/lib/ci-auth-bypass.ts）。NODE_ENV=productionでは常に無効。CIでのスクリーンショット
# 撮影用（scripts/capture-issue-screenshots.sh）で主に使用するが、未設定でもアプリは動作する。
CI_LOGIN_BYPASS_SECRET=

# Fly.io Machines上のオンデマンドプレビュー環境向け（本番DBをコピーして動かす）。
# trueのとき、書き込み系API route（src/lib/preview-mode.ts）が誤って本番のGitHubリポジトリへ
# 書き込みを行わないよう403で封じる。未設定・true以外の値では常に無効。
PREVIEW_MODE=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# CI/デプロイ通知
SIGNALY_WEBHOOK_URL=

# リリース通知（別チャンネル。未設定ならCI/デプロイと同じチャンネルへ送る）
SIGNALY_RELEASE_WEBHOOK_URL=
