# cp .env.local.example .env.local
#
# ローカル開発用。1Password は不要（本番は .github/deploy.env.tpl 経由で1Passwordから注入）。
# 認証はSupabase Auth（GitHubプロバイダー）を使う。GitHub Appは開発用と本番用で分けること。
# Supabaseプロジェクトは新規作成せず、asset-manager等と共有している既存プロジェクト
# （1Password: apps/Supabase）の値を使う（legacyなanon keyではなくpublishable keyを使うこと）。

DATABASE_URL=mysql://issue_deck:devpassword@127.0.0.1:3306/app_issue_deck_dev

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# アカウント削除（Supabase Authユーザーの削除）用。Supabaseダッシュボード → Settings → API Keys → Secret keys。
SUPABASE_SERVICE_ROLE_KEY=

# ログインを許可するメールアドレス（カンマ区切り）。ローカルでは自分のメールアドレスを設定する。
ALLOWED_EMAILS=

# GitHub Appのインストール連携（App JWT署名用）。
# GITHUB_APP_PRIVATE_KEY_BASE64 はGeneral設定でダウンロードしたPEM秘密鍵を
# `base64 -w0 issue-deck-dev.*.private-key.pem` した値。
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
NEXT_PUBLIC_GITHUB_APP_SLUG=

# ユーザー本人のGitHub OAuthアクセストークンの暗号化用鍵（base64エンコードされた32byte）。
# 生成例: openssl rand -base64 32
GITHUB_USER_TOKEN_ENCRYPTION_KEY=

# ユーザー本人のGitHub OAuthアクセストークン失効時、refresh_tokenによる自動延長に使う
# （Supabase AuthのGitHubプロバイダー設定と同一のClient ID/Secretを設定する必要がある）。
# 未設定でもアプリは動作し、自動延長機能のみ無効化される（現状どおり再ログイン導線にフォールバック）
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 進捗管理に使うGitHub Projects v2の場所（#991）。**Issueの進捗はProjectのStatusが唯一の正**で、
# 進捗ラベル（01.planning〜09.main）はPhase 5（#1010）で廃止した。
# 未設定の場合はProject連携そのものが無効になり、すべてのIssueが「未着手」表示になる
# （フォールバック先が無いため）。設計は docs/progress-status-architecture.md
PROJECT_V2_OWNER=
PROJECT_V2_NUMBER=

# 進捗報告API（POST /api/progress）・進捗問い合わせAPI（GET /api/progress）の共有シークレット
# （#991 Phase 2・Phase 5）。GitHub Actionsやローカルのセッションがログインセッション無しに
# 進捗を読み書きするために使う。GitHub側には organization secret `PROGRESS_REPORT_SECRET`
# として同じ値を登録する。
# 未設定なら両APIは常に503を返し、呼び出し側は警告を出してスキップする
PROGRESS_REPORT_SECRET=

# 進捗APIの宛先（#991 Phase 5）。scripts/start-issue.sh がローカルセッションの起動時に
# 進捗を報告するのに使う。**本番のissue-deckのURLを入れる**（Projectを書くのは本番のため、
# ローカルの開発サーバーを指しても盤面は動かない）。
# PROGRESS_REPORT_SECRET とセットで、どちらかが欠けるとスクリプトは報告をスキップして案内を出す。
# GitHub Actions側は同名のorganization/repository変数から解決するため、この設定は不要
APP_BASE_URL=

# サブPCへのディスパッチAPI（POST /api/dispatch/claim・/report・/hosts）の共有シークレット（#1179）。
# サブPCのpoller（scripts/subpc-dispatch-poller.sh）がログインセッション無しにジョブを
# 取りに来るために使う。**PROGRESS_REPORT_SECRET とは別の値にする**（あちらは全リポジトリの
# Actionsから参照できるorganization secretで、ジョブを取れる権限まで同じ値に載せない）。
# 未設定ならディスパッチAPIは常に503を返し、poller側は設定漏れとして案内を出す。
# 設計は docs/multi-agent/subpc-dispatch.md
DISPATCH_SECRET=

# コンフリクトしたPRを巡回して見つける間隔の分数（#2116。省略時は5・0で無効）。
# サブPCのpollerが毎巡 POST /api/pull-requests/conflict-sweep を叩くが、実際に巡回するかは
# この値で決める。GitHub Actions側の自動検知（pull_requestイベント・schedule）が取りこぼした
# コンフリクトを拾うための経路で、設計は src/lib/github/conflict-sweep.ts
CONFLICT_SWEEP_INTERVAL_MINUTES=

# Webhook設定時に生成したsecretと同じ値を設定する（smee.io経由のローカル受信用）
GITHUB_WEBHOOK_SECRET=

# Claudeプラン使用量（5時間枠・週次枠）の表示用。`claude setup-token`で発行する。
# 未設定でもアプリは動作し、当該表示のみ無効化される。
CLAUDE_CODE_OAUTH_TOKEN=

# smee.io経由でローカルにWebhookを転送するためのチャンネルURL（GitHub App設定のWebhook URLと同じ値）。
# `pnpm dev` 実行時、scripts/dev.shがこの値を使ってsmee clientを自動起動する。
# 未設定の場合はsmee clientを起動せず、next devのみ実行する。
GITHUB_WEBHOOK_PROXY_URL=

# Supabase Authを経由せずログイン済み状態を再現するためのバイパス用シークレット
# （src/lib/ci-auth-bypass.ts）。主にCIでのスクリーンショット撮影用
# （scripts/capture-issue-screenshots.sh）だが、NODE_ENV=production以外なら
# ローカル開発でも有効になる。
# ローカルでは手で設定する必要はなく、`pnpm db:seed:dev`が未設定なら生成して書き込む（#1473）。
# 設定されているとログイン画面に「開発用ダミーユーザーでログイン」ボタンが出る。
CI_LOGIN_BYPASS_SECRET=

# Fly.io Machines上のオンデマンドプレビュー環境向け（本番DBをコピーして動かす）。
# trueのとき、書き込み系API route（src/lib/preview-mode.ts）が誤って本番のGitHubリポジトリへ
# 書き込みを行わないよう403で封じる。ローカル開発では通常未設定でよい。
PREVIEW_MODE=

# 開発サーバー（`pnpm dev`）を localhost 以外のホスト名で開くときに追加で許可するオリジン
# （カンマ区切り。#1178）。`**.sslip.io`・`**.ts.net` は next.config.ts が既定で許可するため、
# MagicDNSの短い名前（`subpc`）や生のtailnet IP（`100.x.x.x`）で開く場合だけ設定する。
# 未設定なら既定のみ。開発サーバーにしか効かない。
ISSUE_DECK_DEV_ALLOWED_ORIGINS=

# 開発サーバーの待ち受けアドレス（#1178）。未設定なら `next dev` の既定（全インターフェース。
# Tailscale経由で他端末から見るのはこの既定で成立する）。127.0.0.1 に閉じたいときだけ設定する。
# ただし `tailscale serve` でそのポートを公開している間は、未設定でも 127.0.0.1 に閉じる
# （#1329。serve と同じポートを取り合って `EADDRINUSE` になるのを避けるため）。
ISSUE_DECK_DEV_HOST=
