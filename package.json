{
  "name": "issue-deck",
  "version": "4.28.0",
  "private": true,
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:develop": "bash scripts/start-develop-dev.sh",
    "build": "prisma generate && bash scripts/heavy-command.sh next build",
    "build:ci": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "test:unit": "bash scripts/heavy-command.sh vitest run",
    "postinstall": "prisma generate",
    "version": "node scripts/version-changelog.mjs",
    "env:init": "cp -n .env.local.example .env.local && echo '.env.local を編集してください（DB/Auth/GitHub）'",
    "db:setup": "bash scripts/setup-db.sh",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed:ci": "node scripts/seed-ci-db.mjs",
    "db:seed:dev": "bash scripts/seed-dev-db.sh",
    "capture:issue-screenshots": "bash scripts/capture-issue-screenshots.sh",
    "check:workflows": "node scripts/check-workflow-expression-length.mjs && node scripts/check-workflow-expression-syntax.mjs"
  },
  "dependencies": {
    "@fontsource/biz-udpgothic": "^5.3.0",
    "@fontsource/murecho": "^5.3.0",
    "@octokit/auth-app": "^8.2.0",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "smee-client": "^5.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
